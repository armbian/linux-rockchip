/*
 * Copyright (c) 2026 Rockchip Electronics Co., Ltd.
 *
 * RV1106B EVB2 V10 BGA Dual-Camera AOV (Thunder Boot) DTS
 *
 * Design:
 *   - Base: rv1106b-evb2-v10-bga-dual-cam-tb.dts (dual SC200AI nodes, BGA memory layout)
 *   - AOV extension: rv1106b-amp.dtsi + this file overrides AOV-required nodes
 *   - AOV memory layout (compressed ramdisk):
 *       meta      : 0x00800000  size 0xB0000  (704K)
 *       rkisp0    : 0x008B0000  size 0x54F000
 *       ramdisk_r : 0x00DFF000  size 8M
 *       ramdisk_c : 0x015FF000  size 4M
 *       rkisp1    : 0x019FF000  size 0x54F000
 *   - AOV key nodes:
 *       * gpio-keys + pwr_key (used for sleep wakeup)
 *       * sc200ai/sc200ai_1: stb + soft_sync (AOV dual-camera sync)
 *       * rkcif_mipi_lvds{,_1}: fastboot-reserved-bufs=2 (reduce TB-stage buffers)
 *       * rtc: rtc-suspend-bypass (bypass RTC wakeup under AOV mode)
 *       * rockchip_suspend: status=okay + sleep-io-config (PM sleep IO config)
 */

/dts-v1/;

#include "rv1106b-evb2-v10-bga-dual-cam-tb.dts"
#include "rv1106b-amp.dtsi"

/ {
	model = "Rockchip RV1106B EVB2 V10 BGA Dual Camera AOV TB Board";
	compatible = "rockchip,rv1106b-evb2-v10-bga-dual-cam-aov-tb", "rockchip,rv1106b";

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <&pwr_key>;
		power-key {
			gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			label = "GPIO Key Power";
			debounce-interval = <100>;
			wakeup-source;
			/* gpio-key,wakeup; */
		};
	};
};

&pinctrl {
	buttons {
		pwr_key: pwr-key {
			rockchip,pins = <0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&meta {
	/* AOV: same as non-AOV, 704K meta */
	reg = <0x00800000 0xb0000>;
};

&rkisp_thunderboot {
	/* AOV mode: ISP0 TB memory address unchanged */
	reg = <0x008b0000 0x54f000>;
};

&ramdisk_r {
	/* AOV mode: 8M (non-AOV uses 12M) */
	reg = <0xdff000 (8 * 0x00100000)>;
};

&ramdisk_c {
	/* AOV mode: 4M (non-AOV uses 5M) */
	reg = <0x15ff000 (4 * 0x00100000)>;
};

&rkisp1_thunderboot {
	/*
	 * 0x19ff000 = (ramdisk_c reg offset) + (ramdisk_c reg size)
	 *           = 0x15ff000 + (4 * 0x00100000)
	 */
	reg = <0x19ff000 0x54f000>;
};

&rkcif_mipi_lvds {
	fastboot-reserved-bufs = <2>;
};

&rkcif_mipi_lvds1 {
	fastboot-reserved-bufs = <2>;
};

&rtc {
	rockchip,rtc-suspend-bypass;
	status = "okay";
};

&sc200ai {
	rockchip,camera-module-stb = <1>;
	rockchip,camera-module-sync-mode = "soft_sync";
};

&sc200ai_1 {
	rockchip,camera-module-stb = <1>;
	rockchip,camera-module-sync-mode = "soft_sync";
};

&rockchip_suspend {
	status = "okay";

	rockchip,sleep-io-config = <
		/* pmic_sleep */
		(0
		| RKPM_IO_CFG_IOMUX_GPIO
		| RKPM_IO_CFG_GPIO_DIR_INPUT
		| RKPM_IO_CFG_PULL_DOWN
		| RKPM_IO_CFG_ID(0)
		)
		(0
		| RKPM_IO_CFG_IOMUX_GPIO
		| RKPM_IO_CFG_GPIO_DIR_INPUT
		| RKPM_IO_CFG_PULL_NONE
		| RKPM_IO_CFG_ID(1)
		)
		(0
		| RKPM_IO_CFG_IOMUX_GPIO
		| RKPM_IO_CFG_GPIO_DIR_INPUT
		| RKPM_IO_CFG_PULL_NONE
		| RKPM_IO_CFG_ID(2)
		)
		(0
		| RKPM_IO_CFG_IOMUX(1)
		| RKPM_IO_CFG_PULL_NONE
		| RKPM_IO_CFG_ID(3)
		)
		(0
		| RKPM_IO_CFG_IOMUX_GPIO
		| RKPM_IO_CFG_GPIO_DIR_INPUT
		| RKPM_IO_CFG_PULL_UP
		| RKPM_IO_CFG_ID(4)
		)
		(0
		| RKPM_IO_CFG_IOMUX_GPIO
		| RKPM_IO_CFG_GPIO_DIR_INPUT
		| RKPM_IO_CFG_PULL_DOWN
		| RKPM_IO_CFG_ID(5)
		)
		(0
		| RKPM_IO_CFG_IOMUX_GPIO
		| RKPM_IO_CFG_GPIO_DIR_INPUT
		| RKPM_IO_CFG_PULL_DOWN
		| RKPM_IO_CFG_ID(6)
		)
	>;
};
