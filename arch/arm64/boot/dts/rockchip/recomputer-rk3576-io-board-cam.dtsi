/ {

/*     cam0_pwr: cam0-pwr { */
/*         status = "disabled"; */
/*         compatible = "regulator-fixed"; */
/*         regulator-name = "cam0_pwr"; */
/*         regulator-min-microvolt = <3300000>; */
/*         regulator-max-microvolt = <3300000>; */
/*         enable-active-high; */
/*         gpio = <&gpio_xten  0  GPIO_ACTIVE_HIGH>; */
/*         regulator-boot-on; */
/*         regulator-always-on; */
/*     }; */

    cam1_pwr: cam1-pwr {
        status = "disabled";
        compatible = "regulator-fixed";
        regulator-name = "cam1_pwr";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        enable-active-high;
        gpio = <&gpio1  RK_PD1  GPIO_ACTIVE_HIGH>; 
        regulator-boot-on;         
        regulator-always-on;        
    };
    

	cam0_rst: cam0-rst {
		compatible = "regulator-fixed";
		regulator-name = "cam0_pwr";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	cam1_rst: cam1-rst {
		compatible = "regulator-fixed";
		regulator-name = "cam1_pwr";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

    clk_cam_24m: external-camera-clock-24m {
        status = "okay";
        compatible = "fixed-clock";
        clock-frequency = <24000000>;
        clock-output-names = "clk_cam_24m";
        #clock-cells = <0>;
    };

    clk_cam_24m_1: external-camera-clock-24m-1 {
        status = "okay";
        compatible = "fixed-clock";
        clock-frequency = <24000000>;
        clock-output-names = "clk_cam_24m_1";
        #clock-cells = <0>;
    };

};

// cam0: i2c5
&i2c5 {
	status = "okay";
	pinctrl-0 = <&i2c5m2_xfer>;

    imx219_0: imx219@10 {
        status = "disabled";
        compatible = "sony,imx219";
        reg = <0x10>;
        clocks = <&clk_cam_24m>;
        clock-names = "xvclk";
        /* vana-supply = <&cam0_pwr>; */
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "rpi-camera-v2";
        rockchip,camera-module-lens-name = "default";

        port {
            imx219_out0: endpoint {
                remote-endpoint = <&mipi_in_ucam2>;
                data-lanes = <1 2>;					
            };
        };
    };


	dw9817_0: dw9817@c {
		compatible = "dongwoon,dw9800w";
		status = "okay";
		reg = <0x0c>;
		VDD-supply = <&cam0_rst>;
		/* power-supply = <&cam0_pwr>; */
		rockchip,camera-module-index = <0>;
		rockchip,vcm-start-current = <10>;
		rockchip,vcm-rated-current = <85>;
		rockchip,vcm-step-mode = <5>;
		rockchip,camera-module-facing = "back";

	};

	imx708_0: imx708@1a {
		status = "okay";
		compatible = "sony,imx708";
		reg = <0x1a>;
		clocks = <&clk_cam_24m>;
		clock-names = "xclk";
		/* vana1-supply = <&cam0_pwr>; */
		pinctrl-names = "default";

		reset-gpios = <&gpio2 RK_PA6 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "rpi-camera-v3";
		rockchip,camera-module-lens-name = "default";
		lens-focus = <&dw9817_0>;
		port {
            imx708_out0: endpoint {
                remote-endpoint = <&mipi_in_ucam4>;
                data-lanes = <1 2>;
                link-frequencies = /bits/ 64 <450000000>;
            };
		};
	};
};

// cam1: i2c6
&i2c6 {
	status = "okay";

    imx219_1: imx219@10 {
        status = "disabled";
        compatible = "sony,imx219";
        reg = <0x10>;

        clocks = <&clk_cam_24m_1>;
        clock-names = "xvclk";
        vana-supply = <&cam1_pwr>;
       	rockchip,camera-module-index = <1>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "rpi-camera-v2";
        rockchip,camera-module-lens-name = "default";

        port {
            imx219_out1: endpoint {
                remote-endpoint = <&mipi_in_ucam3>;
                data-lanes = <1 2>;					
            };
        };
    };

 /**************raspberry pi cam v3**************/
	dw9817_1: dw9817@c {
		compatible = "dongwoon,dw9800w";
		status = "okay";
		reg = <0x0c>;
		VDD-supply = <&cam1_rst>;
		/* power-supply = <&cam1_pwr>; */
		rockchip,camera-module-index = <1>;
		rockchip,vcm-start-current = <10>;
		rockchip,vcm-rated-current = <85>;
		rockchip,vcm-step-mode = <5>;
		rockchip,camera-module-facing = "back";

	};

	imx708_1: imx708@1a {
		status = "okay";
		compatible = "sony,imx708";
		reg = <0x1a>;
		clocks = <&clk_cam_24m_1>;
		clock-names = "xclk";
		reset-gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		/* vana1-supply = <&cam1_pwr>; */
		pinctrl-names = "default";
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "rpi-camera-v3";
		rockchip,camera-module-lens-name = "default";
		lens-focus = <&dw9817_1>;
		port {
            imx708_out1: endpoint {
                remote-endpoint = <&mipi_in_ucam5>;
                data-lanes = <1 2>;
                link-frequencies = /bits/ 64 <450000000>;
				
            };
		};
	};
};

/*-----------------------------------------------------------------------*/

&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_ucam2: endpoint@2 {
				reg = <2>;
				remote-endpoint = <&imx219_out0>;
				data-lanes = <1 2>;
			};

			mipi_in_ucam4: endpoint@3 {
				reg = <3>;
				remote-endpoint = <&imx708_out0>;
				data-lanes = <1 2>;
			};

		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi1_csi2_input>;
			};
		};
	};
};

&csi2_dphy2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_ucam3: endpoint@2 {
				reg = <2>;
				remote-endpoint = <&imx219_out1>;
				data-lanes = <1 2>;
			};
			mipi_in_ucam5: endpoint@3 {
				reg = <3>;
				remote-endpoint = <&imx708_out1>;
				data-lanes = <1 2>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy2_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi3_csi2_input>;
			};
		};
	};
};

&csi2_dphy3 {
    status = "disabled";
};

/*-----------------------------------------------------------------------*/

&mipi1_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi1_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi1_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in1>;
			};
		};
	};
};

&mipi3_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi3_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy2_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi3_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in3>;
			};
		};
	};
};

/*-----------------------------------------------------------------------*/

&rkcif_mipi_lvds1 {
	status = "okay";

	port {
		cif_mipi_in1: endpoint {
			remote-endpoint = <&mipi1_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds3 {
	status = "okay";

	port {
		cif_mipi_in3: endpoint {
			remote-endpoint = <&mipi3_csi2_output>;
		};
	};
};

/*-----------------------------------------------------------------------*/

&rkcif_mipi_lvds1_sditf {
	status = "okay";

	port {
		mipi_lvds1_sditf: endpoint {
			remote-endpoint = <&isp_vir0>;
		};
	};
};

&rkcif_mipi_lvds3_sditf {
	status = "okay";

	port {
		mipi_lvds3_sditf: endpoint {
			remote-endpoint = <&isp_vir1>;
		};
	};
};

/*-----------------------------------------------------------------------*/

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds1_sditf>;
		};
	};
};

&rkisp_vir1 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir1: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds3_sditf>;
		};
	};
};

