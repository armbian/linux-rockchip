	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		isp_in_gc02m0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&dphy1_out_isp>;
		};
		isp_in_gc02m1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&dphy2_out_isp>;
		};
	};
};
