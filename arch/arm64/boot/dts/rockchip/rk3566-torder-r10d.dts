&csi2_dphy_hw {
	status = "okay";
};

&csi2_dphy1 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			dphy1_in_gc02m0: endpoint {
				remote-endpoint = <&gc02m0_out>;
				data-lanes = <1>;
			};
		};
		port@1 {
			reg = <1>;
			dphy1_out_isp: endpoint {
				remote-endpoint = <&isp_in_gc02m0>;
			};
		};
	};
};

&csi2_dphy2 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			dphy2_in_gc02m1: endpoint {
				remote-endpoint = <&gc02m1_out>;
				data-lanes = <1>;
			};
		};
		port@1 {
			reg = <1>;
			dphy2_out_isp: endpoint {
				remote-endpoint = <&isp_in_gc02m1>;
			};
		};
	};
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	/* Both sensors share this clock output. */
	pinctrl-0 = <&i2c2m1_xfer &cif_clk>;

	gc02m0: camera-rear@37 {
		compatible = "galaxycore,gc02m0";
		reg = <0x37>;
		clocks = <&cru CLK_CIF_OUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3568_PD_VI>;
		reset-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "KYT-4877-V01";
		rockchip,camera-module-lens-name = "default";
		port {
			gc02m0_out: endpoint {
				remote-endpoint = <&dphy1_in_gc02m0>;
				data-lanes = <1>;
			};
		};
	};

	gc02m1: camera-front@37 {
		compatible = "galaxycore,gc02m1";
		reg = <0x37>;
		clocks = <&cru CLK_CIF_OUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3568_PD_VI>;
		reset-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "KYT-4877-V01";
		rockchip,camera-module-lens-name = "default";
		port {
			gc02m1_out: endpoint {
				remote-endpoint = <&dphy2_in_gc02m1>;
				data-lanes = <1>;
			};
		};
	};
};

