	status = "okay";
};

&mpp_srv {
	status = "okay";
};

&pinctrl {

	usb {

		vcc5v0_usb_host1_en: vcc5v0-usb-host1-en {
			rockchip,pins = <3 RK_PB7 0 &pcfg_pull_none>;
		};

		vcc5v0_usb_host2_en: vcc5v0-usb-host2-en {
			rockchip,pins = <3 RK_PC0 0 &pcfg_pull_none>;
		};
	};

	vcc_sd {

		vcc_sd_h: vcc-sd-h {
			rockchip,pins = <0 RK_PA5 0 &pcfg_pull_none>;
		};
	};

	lcd {

		lcd_rst: lcd-rst-gpio {
			rockchip,pins = <3 RK_PC3 0 &pcfg_pull_none>;
		};

		lcd_en: lcd-enable-gpio {
			rockchip,pins = <3 RK_PB1 0 &pcfg_pull_none>;
		};
	};

	hp-detect {

		hp_det: hp-det {
			rockchip,pins = <3 RK_PA1 0 &pcfg_pull_none>;
		};
	};

	ts {

		ts_int: ts-int {
			rockchip,pins = <0 RK_PB0 0 &pcfg_pull_up>;
		};
	};

	camera {
		camera_power_en: camera-power-en {
			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pmu_io_domains {
	status = "okay";
	pmuio1-supply = <&vcc3v3_pmu>;
