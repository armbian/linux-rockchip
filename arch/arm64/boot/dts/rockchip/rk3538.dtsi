 */

#include <dt-bindings/clock/rockchip,rk3538-cru.h>
#include <dt-bindings/display/rockchip-tve.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/power/rockchip,rk3538-power-controller.h>
#include <dt-bindings/reset/rockchip,rk3538-cru.h>
#include <dt-bindings/soc/rockchip,boot-mode.h>
#include <dt-bindings/soc/rockchip-system-status.h>
#include <dt-bindings/suspend/rockchip-rk3538.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "rockchip,rk3538";

	interrupt-parent = <&gic>;
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		ethernet1 = &mac;
		gpio0 = &gpio0;
		gpio1 = &gpio1;
		gpio2 = &gpio2;
		gpio3 = &gpio3;
		gpio4 = &gpio4;
		gpio5 = &gpio5;
		gpio6 = &gpio6;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		spi0 = &spi0;
		spi1 = &spi1;
		spi2 = &fspi;
	};

	clocks {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		mclkin_sai0: mclkin-sai0 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
			clock-output-names = "mclk_sai0_from_io";
		};

		mclkin_sai1: mclkin-sai1 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
			clock-output-names = "mclk_sai1_from_io";
		};

		mclkin_sai2: mclkin-sai2 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
			clock-output-names = "mclk_sai2_from_io";
		};

		spll: spll {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <900000000>;
			clock-output-names = "spll";
		};

		xin24m: xin24m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
			clock-output-names = "xin24m";
		};

		mclkout_sai0: mclkout-sai0@fd190000 {
			compatible = "rockchip,clk-out";
			reg = <0xfd190000 0x4>;
			clocks = <&cru MCLK_SAI0_OUT2IO>;
			#clock-cells = <0>;
			clock-output-names = "mclk_sai0_to_io";
			rockchip,bit-shift = <9>;
			rockchip,bit-set-to-disable;
		};

		mclkout_sai1: mclkout-sai1@fd100040 {
			compatible = "rockchip,clk-out";
			reg = <0xfd100040 0x4>;
			clocks = <&cru MCLK_SAI1_OUT2IO>;
			#clock-cells = <0>;
			clock-output-names = "mclk_sai1_to_io";
			rockchip,bit-shift = <1>;
			rockchip,bit-set-to-disable;
		};

		mclkout_sai2: mclkout-sai2@fd170008 {
			compatible = "rockchip,clk-out";
			reg = <0xfd170008 0x4>;
			clocks = <&cru MCLK_SAI2_OUT2IO>;
			#clock-cells = <0>;
			clock-output-names = "mclk_sai2_to_io";
			rockchip,bit-shift = <15>;
			rockchip,bit-set-to-disable;
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
			};
			cluster1 {
				core0 {
					cpu = <&cpu2>;
				};
				core1 {
					cpu = <&cpu3>;
				};
			};
		};

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0>;
			enable-method = "psci";
			capacity-dmips-mhz = <1024>;
			clocks = <&scmi_clk ARMCLK01>;
			operating-points-v2 = <&cpu01_opp_table>;
			#cooling-cells = <2>;
			dynamic-power-coefficient = <125>;
			cpu-idle-states = <&CPU_SLEEP>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <1024>;
			clocks = <&scmi_clk ARMCLK01>;
			operating-points-v2 = <&cpu01_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <1024>;
			clocks = <&scmi_clk ARMCLK23>;
			operating-points-v2 = <&cpu23_opp_table>;
			#cooling-cells = <2>;
			dynamic-power-coefficient = <135>;
			cpu-idle-states = <&CPU_SLEEP>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <1024>;
			clocks = <&scmi_clk ARMCLK23>;
			operating-points-v2 = <&cpu23_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
		};

		idle-states {
			entry-method = "psci";
			CPU_SLEEP: cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x0010000>;
				entry-latency-us = <100>;
				exit-latency-us = <120>;
				min-residency-us = <1000>;
			};
		};
	};

	cpu01_opp_table: cpu01-opp-table {
		compatible = "operating-points-v2";
		opp-shared;

		nvmem-cells = <&cpu_leakage>, <&cpu01_opp_info>;
		nvmem-cell-names = "leakage", "opp-info";

		rockchip,video-4k-freq = <1200000>;
		rockchip,pvtm-voltage-sel = <
			0	1394	0
			1400	1535	1
			1425	1555	2
			1450	1555	3
			1468	1555	4
			1486	1555	5
			1504	9999	6
		>;
		rockchip,pvtm-pvtpll;
		rockchip,pvtm-offset = <0x54>;
		rockchip,pvtm-sample-time = <1100>;
		rockchip,pvtm-freq = <1416000>;
		rockchip,pvtm-volt = <950000>;
		rockchip,pvtm-ref-temp = <35>;
		rockchip,pvtm-temp-prop = <0 0>;
		rockchip,pvtm-thermal-zone = "soc-thermal";
		rockchip,grf = <&core0_pvtpll>;

		rockchip,temp-hysteresis = <5000>;
		rockchip,low-temp = <10000>;
		rockchip,low-temp-min-volt = <950000>;

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <850000 850000 1100000>;
			clock-latency-ns = <40000>;
			opp-suspend;
		};
		opp-816000000 {
			opp-hz = /bits/ 64 <816000000>;
			opp-microvolt = <850000 850000 1100000>;
			clock-latency-ns = <40000>;
		};
		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <850000 850000 1100000>;
			clock-latency-ns = <40000>;
		};
		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <912500 912500 1100000>;
			opp-microvolt-L1 = <900000 900000 1100000>;
			opp-microvolt-L2 = <887500 887500 1100000>;
			opp-microvolt-L3 = <887500 887500 1100000>;
			opp-microvolt-L4 = <875000 875000 1100000>;
			opp-microvolt-L5 = <875000 875000 1100000>;
			opp-microvolt-L6 = <862500 862500 1100000>;
			clock-latency-ns = <40000>;
		};
		opp-1416000000 {
			opp-hz = /bits/ 64 <1416000000>;
			opp-microvolt = <962500 962500 1100000>;
			opp-microvolt-L1 = <950000 950000 1100000>;
			opp-microvolt-L2 = <950000 950000 1100000>;
			opp-microvolt-L3 = <937500 937500 1100000>;
			opp-microvolt-L4 = <937500 937500 1100000>;
			opp-microvolt-L5 = <925000 925000 1100000>;
			opp-microvolt-L6 = <912500 912500 1100000>;
			clock-latency-ns = <40000>;
		};
	};

	cpu23_opp_table: cpu23-opp-table {
		compatible = "operating-points-v2";
		opp-shared;

		nvmem-cells = <&cpu_leakage>, <&cpu23_opp_info>;
		nvmem-cell-names = "leakage", "opp-info";

		rockchip,video-4k-freq = <1200000>;
		rockchip,pvtm-voltage-sel = <
			0	1394	0
			1400	1535	1
			1425	1555	2
			1450	1555	3
			1468	1555	4
			1486	1555	5
			1504	9999	6
		>;
		rockchip,pvtm-pvtpll;
		rockchip,pvtm-offset = <0x54>;
		rockchip,pvtm-sample-time = <1100>;
		rockchip,pvtm-freq = <1416000>;
		rockchip,pvtm-volt = <950000>;
		rockchip,pvtm-ref-temp = <35>;
		rockchip,pvtm-temp-prop = <0 0>;
		rockchip,pvtm-thermal-zone = "soc-thermal";
		rockchip,grf = <&core1_pvtpll>;

		rockchip,temp-hysteresis = <5000>;
		rockchip,low-temp = <10000>;
		rockchip,low-temp-min-volt = <950000>;

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <850000 850000 1100000>;
			clock-latency-ns = <40000>;
			opp-suspend;
		};
		opp-816000000 {
			opp-hz = /bits/ 64 <816000000>;
			opp-microvolt = <850000 850000 1100000>;
			clock-latency-ns = <40000>;
		};
		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <850000 850000 1100000>;
			clock-latency-ns = <40000>;
		};
		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <912500 912500 1100000>;
			opp-microvolt-L1 = <900000 900000 1100000>;
			opp-microvolt-L2 = <887500 887500 1100000>;
			opp-microvolt-L3 = <887500 887500 1100000>;
			opp-microvolt-L4 = <875000 875000 1100000>;
			opp-microvolt-L5 = <875000 875000 1100000>;
			opp-microvolt-L6 = <862500 862500 1100000>;
			clock-latency-ns = <40000>;
		};
		opp-1416000000 {
			opp-hz = /bits/ 64 <1416000000>;
			opp-microvolt = <962500 962500 1100000>;
			opp-microvolt-L1 = <950000 950000 1100000>;
			opp-microvolt-L2 = <950000 950000 1100000>;
			opp-microvolt-L3 = <937500 937500 1100000>;
			opp-microvolt-L4 = <937500 937500 1100000>;
			opp-microvolt-L5 = <925000 925000 1100000>;
			opp-microvolt-L6 = <912500 912500 1100000>;
			clock-latency-ns = <40000>;
		};
		opp-1512000000 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-microvolt = <1000000 1000000 1100000>;
			opp-microvolt-L1 = <987500 987500 1100000>;
			opp-microvolt-L2 = <975000 975000 1100000>;
			opp-microvolt-L3 = <962500 962500 1100000>;
			opp-microvolt-L4 = <950000 950000 1100000>;
			opp-microvolt-L5 = <937500 937500 1100000>;
			opp-microvolt-L6 = <937500 937500 1100000>;
			clock-latency-ns = <40000>;
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <GIC_SPI 224 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 225 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 226 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 227 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
	};

	cpuinfo {
		compatible = "rockchip,cpuinfo";
		nvmem-cells = <&otp_id>, <&otp_cpu_version>, <&cpu_code>;
		nvmem-cell-names = "id", "cpu-version", "cpu-code";
	};

	display_subsystem: display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <&vop_out>;

		route {
			route_hdmi: route-hdmi {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp0_out_hdmi>;
			};

			route_tve: route-tve {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp0_out_tve>;
			};
		};
	};

	dmc: dmc {
		compatible = "rockchip,rk3538-dmc";
		interrupts = <GIC_SPI 98 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "complete";
		devfreq-events = <&dfi>;
		clocks = <&scmi_clk SCLK_DDR>;
		clock-names = "dmc_clk";
		operating-points-v2 = <&dmc_opp_table>;
		upthreshold = <40>;
		downdifferential = <20>;
		system-status-level = <
			/* system status	freq level */
			SYS_STATUS_NORMAL	DMC_FREQ_LEVEL_HIGH
		>;
		auto-min-freq = <324000>;
		auto-freq-en = <0>;
		status = "disabled";
	};

	dmc_opp_table: dmc-opp-table {
		compatible = "operating-points-v2";

		nvmem-cells = <&log_leakage>, <&dmc_opp_info>;
		nvmem-cell-names = "leakage", "opp-info";

		rockchip,leakage-voltage-sel = <
			1   15   0
			16  25   1
			21  254  2
		>;

		rockchip,temp-hysteresis = <5000>;
		rockchip,low-temp = <10000>;
		rockchip,low-temp-min-volt = <900000>;

		opp-324000000 {
			opp-hz = /bits/ 64 <324000000>;
			opp-microvolt = <850000 850000 950000>;
		};
		opp-528000000 {
			opp-hz = /bits/ 64 <528000000>;
			opp-microvolt = <850000 850000 950000>;
		};
		opp-780000000 {
			opp-hz = /bits/ 64 <780000000>;
			opp-microvolt = <850000 850000 950000>;
		};
		opp-1184000000 {
			opp-hz = /bits/ 64 <1184000000>;
			opp-microvolt = <900000 900000 950000>;
			opp-microvolt-L1 = <887500 887500 950000>;
			opp-microvolt-L2 = <875000 875000 950000>;
		};
	};

	dsu-pmu {
		compatible = "arm,dsu-pmu";
		interrupts = <GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH>;
		cpus = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
		status = "fail";
	};

	firmware {
		scmi: scmi {
			compatible = "arm,scmi-smc";
			shmem = <&scmi_shmem>;
			arm,smc-id = <0x82000010>;
			#address-cells = <1>;
			#size-cells = <0>;

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;

				assigned-clocks = <&scmi_clk ARMCLK01>,
						  <&scmi_clk ARMCLK23>;
				assigned-clock-rates = <1416000000>,
						       <1416000000>;
			};
		};
	};

	mpp_srv: mpp-srv {
		compatible = "rockchip,mpp-service";
		rockchip,taskqueue-count = <4>;
		rockchip,resetgroup-count = <4>;
		status = "disabled";
	};

	pinctrl: pinctrl {
		compatible = "rockchip,rk3538-pinctrl";
		rockchip,grf = <&ioc_grf>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		gpio0: gpio@fc300000 {
			compatible = "rockchip,gpio-bank";
			reg = <0xfc300000 0x200>;
			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_PMU_GPIO0>, <&cru DBCLK_PMU_GPIO0>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 0 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio1: gpio@fc400000 {
			compatible = "rockchip,gpio-bank";
			reg = <0xfc400000 0x200>;
			interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO1>, <&cru DBCLK_GPIO1>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 32 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio2: gpio@fc500000 {
			compatible = "rockchip,gpio-bank";
			reg = <0xfc500000 0x200>;
			interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO2>, <&cru DBCLK_GPIO2>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 64 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio3: gpio@fc600000 {
			compatible = "rockchip,gpio-bank";
			reg = <0xfc600000 0x200>;
			interrupts = <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO3>, <&cru DBCLK_GPIO3>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 96 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio4: gpio@fc700000 {
			compatible = "rockchip,gpio-bank";
			reg = <0xfc700000 0x200>;
			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO4>, <&cru DBCLK_GPIO4>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 128 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio5: gpio@fc800000 {
			compatible = "rockchip,gpio-bank";
			reg = <0xfc800000 0x200>;
			interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO5>, <&cru DBCLK_GPIO5>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 160 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio6: gpio@fc900000 {
			compatible = "rockchip,gpio-bank";
			reg = <0xfc900000 0x200>;
			interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO6>, <&cru DBCLK_GPIO6>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 192 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};

	psci: psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	reserved_memory: reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
	};

	rockchip_suspend: rockchip-suspend {
		compatible = "rockchip,pm-rk3538";
		status = "disabled";
		rockchip,sleep-debug-en = <1>;
		rockchip,sleep-mode-config = <
			(0
			| RKPM_SLP_DEEP1_MODE
			| RKPM_SLP_PMIC_LP
			| RKPM_SLP_HW_PLLS_OFF
			| RKPM_SLP_PMUALIVE_32K
			| RKPM_SLP_OSC_DIS
			| RKPM_SLP_32K_EXT
			)
		>;
		rockchip,wakeup-config = <
			(0
			| WAKEUP_PWM0_CH0_INT
			| WAKEUP_PWM0_CH1_INT
			| WAKEUP_PWM0_CH2_INT
			| WAKEUP_PWM0_CH3_INT
			| WAKEUP_GPIO0_INT
			)
		>;
	};

	rockchip_system_monitor: rockchip-system-monitor {
		compatible = "rockchip,system-monitor";
		rockchip,thermal-zone = "soc-thermal";
	};

	thermal_zones: thermal-zones {
		soc_thermal: soc-thermal {
			polling-delay-passive = <20>; /* milliseconds */
			polling-delay = <1000>; /* milliseconds */
			sustainable-power = <314>; /* milliwatts */
			thermal-sensors = <&tsadc 0>;
			trips {
				threshold: trip-point-0 {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "passive";
				};
				target: trip-point-1 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				soc_crit: soc-crit {
					/* millicelsius */
					temperature = <115000>;
					/* millicelsius */
					hysteresis = <2000>;
					type = "critical";
				};
			};
			cooling-maps {
				map0 {
					trip = <&target>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
				map1 {
					trip = <&target>;
					cooling-device = <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
				map2 {
					trip = <&target>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1152>;
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		scmi_shmem: scmi-shmem@10f000 {
			compatible = "arm,scmi-shmem";
			reg = <0x0010f000 0x100>;
		};

		sram: sram@fafd0000 {
			compatible = "mmio-sram";
			reg = <0xfafd0000 0x19000>;

			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0 0xfafd0000 0x19000>;

			/* start address and size should be 4k align */
			rkvdec_sram: rkvdec-sram@0 {
				reg = <0x0 0x19000>;
			};
		};

		gpu: gpu@fb000000 {
			compatible = "arm,mali-valhall";
			reg = <0xfb000000 0x200000>;
			interrupts = <GIC_SPI 147 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 148 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "GPU", "MMU", "JOB";

			clocks = <&scmi_clk CLK_GPU_CORE>, <&cru CLK_GPU_CORE>;
			clock-names = "clk_gpu";
			operating-points-v2 = <&gpu_opp_table>;
			#cooling-cells = <2>;
			dynamic-power-coefficient = <575>;

			upthreshold = <30>;
			downdifferential = <10>;

			status = "disabled";
		};

		gpu_opp_table: gpu-opp-table {
			compatible = "operating-points-v2";

			nvmem-cells = <&log_leakage>, <&gpu_opp_info>;
			nvmem-cell-names = "leakage", "opp-info";

			rockchip,opp-clocks = <&cru CLK_GPU_CORE>;

			rockchip,pvtm-voltage-sel = <
				0	595	0
				596	610	1
				611	625	2
				626	9999	3
			>;
			rockchip,pvtm-pvtpll;
			rockchip,pvtm-offset = <0x54>;
			rockchip,pvtm-sample-time = <1100>;
			rockchip,pvtm-freq = <500000>;
			rockchip,pvtm-volt = <950000>;
			rockchip,pvtm-ref-temp = <35>;
			rockchip,pvtm-temp-prop = <0 0>;
			rockchip,pvtm-thermal-zone = "soc-thermal";
			rockchip,grf = <&gpu_pvtpll>;

			rockchip,temp-hysteresis = <5000>;
			rockchip,low-temp = <10000>;
			rockchip,low-temp-min-volt = <900000>;

			opp-400000000 {
				opp-hz = /bits/ 64 <400000000>;
				opp-microvolt = <850000 850000 950000>;
			};
			opp-500000000 {
				opp-hz = /bits/ 64 <500000000>;
				opp-microvolt = <875000 875000 950000>;
				opp-microvolt-L2 = <862500 862500 950000>;
				opp-microvolt-L3 = <850000 850000 950000>;
			};
		};

		usb_drd_dwc3: usb@fc000000 {
			compatible = "rockchip,rk3538-dwc3", "rockchip,rk3576-dwc3", "snps,dwc3";
			reg = <0xfc000000 0x100000>;
			clocks = <&cru CLK_REF_USB2OTG>,
				 <&cru CLK_SUSPEND_USB2OTG>,
				 <&cru ACLK_USB2OTG>;
			clock-names = "ref", "suspend", "bus_clk";
			interrupts = <GIC_SPI 201 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&cru SRST_ARESETN_USB2OTG>;
			reset-names = "usb3-otg";
			dr_mode = "otg";
			phys = <&u2phy_otg>;
			phy-names = "usb2-phy";
			phy_type = "utmi_wide";
			maximum-speed = "high-speed";
			snps,dis_enblslpm_quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis_u2_susphy_quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			snps,parkmode-disable-hs-quirk;
			snps,usb2-gadget-lpm-disable;
			snps,usb2-lpm-disable;
			status = "disabled";
		};

		usb_host_ehci: usb@fc100000 {
			compatible = "generic-ehci";
			reg = <0xfc100000 0x80000>;
			interrupts = <GIC_SPI 191 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru HCLK_USB2HOST>, <&cru HCLK_ARB_USB2HOST>, <&usb2phy>;
			clock-names = "usbhost", "arbiter", "utmi";
			phys = <&u2phy_host>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		usb_host_ohci: usb@fc180000 {
			compatible = "generic-ohci";
			reg = <0xfc180000 0x80000>;
			interrupts = <GIC_SPI 192 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru HCLK_USB2HOST>, <&cru HCLK_ARB_USB2HOST>, <&usb2phy>;
			clock-names = "usbhost", "arbiter", "utmi";
			phys = <&u2phy_host>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		debug: debug@fc204000 {
			compatible = "rockchip,debug";
			reg = <0xfc204000 0x1000>,
			      <0xfc205000 0x1000>,
			      <0xfc206000 0x1000>,
			      <0xfc207000 0x1000>;
		};

		cspmu: cspmu@fc20c000 {
			compatible = "rockchip,cspmu";
			reg = <0xfc20c000 0x1000>,
			      <0xfc20d000 0x1000>,
			      <0xfc20e000 0x1000>,
			      <0xfc20f000 0x1000>;
		};

		pwm0_4ch_0: pwm@fca00000 {
			compatible = "rockchip,rk3538-pwm";
			reg = <0xfca00000 0x1000>;
			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm0m0_ch0_pins>;
			clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>, <&cru CLK_OSC_PWM0>, <&cru CLK_RC_PWM0>;
			clock-names = "pwm", "pclk", "osc", "rc";
			status = "disabled";
		};

		pwm0_4ch_1: pwm@fca10000 {
			compatible = "rockchip,rk3538-pwm";
			reg = <0xfca10000 0x1000>;
			interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm0m0_ch1_pins>;
			clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>, <&cru CLK_OSC_PWM0>, <&cru CLK_RC_PWM0>;
			clock-names = "pwm", "pclk", "osc", "rc";
			status = "disabled";
		};

		pwm0_4ch_2: pwm@fca20000 {
			compatible = "rockchip,rk3538-pwm";
			reg = <0xfca20000 0x1000>;
			interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm0m0_ch2_pins>;
			clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>, <&cru CLK_OSC_PWM0>, <&cru CLK_RC_PWM0>;
			clock-names = "pwm", "pclk", "osc", "rc";
			status = "disabled";
		};

		pwm0_4ch_3: pwm@fca30000 {
			compatible = "rockchip,rk3538-pwm";
			reg = <0xfca30000 0x1000>;
			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm0m0_ch3_pins>;
			clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>, <&cru CLK_OSC_PWM0>, <&cru CLK_RC_PWM0>;
			clock-names = "pwm", "pclk", "osc", "rc";
			status = "disabled";
		};

		pwm1_4ch_0: pwm@fcb00000 {
			compatible = "rockchip,rk3538-pwm";
			reg = <0xfcb00000 0x1000>;
			interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm1m0_ch0_pins>;
			clocks = <&cru CLK_PWM1>, <&cru PCLK_PWM1>, <&cru CLK_OSC_PWM1>, <&cru CLK_RC_PWM1>;
			clock-names = "pwm", "pclk", "osc", "rc";
			dmas = <&dmac 33>;
			dma-names = "ledc-tx";
			status = "disabled";
		};

		pwm1_4ch_1: pwm@fcb10000 {
			compatible = "rockchip,rk3538-pwm";
			reg = <0xfcb10000 0x1000>;
			interrupts = <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm1m0_ch1_pins>;
			clocks = <&cru CLK_PWM1>, <&cru PCLK_PWM1>, <&cru CLK_OSC_PWM1>, <&cru CLK_RC_PWM1>;
			clock-names = "pwm", "pclk", "osc", "rc";
			dmas = <&dmac 34>;
			dma-names = "ledc-tx";
			status = "disabled";
