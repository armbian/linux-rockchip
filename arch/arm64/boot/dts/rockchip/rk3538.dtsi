		pwm1_4ch_3: pwm@fcb30000 {
			compatible = "rockchip,rk3538-pwm";
			reg = <0xfcb30000 0x1000>;
			interrupts = <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm1m0_ch3_pins>;
			clocks = <&cru CLK_PWM1>, <&cru PCLK_PWM1>, <&cru CLK_OSC_PWM1>, <&cru CLK_RC_PWM1>;
			clock-names = "pwm", "pclk", "osc", "rc";
			status = "disabled";
		};

		mailbox0: mailbox@fcc00000 {
			compatible = "rockchip,rk3538-mailbox", "rockchip,rk3576-mailbox";
			reg = <0xfcc00000 0x40>;
			interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_MAILBOX>;
			clock-names = "pclk_mailbox";
			#mbox-cells = <1>;
			status = "disabled";
		};

		mailbox1: mailbox@fcc10000 {
			compatible = "rockchip,rk3538-mailbox", "rockchip,rk3576-mailbox";
			reg = <0xfcc10000 0x40>;
			interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_MAILBOX>;
			clock-names = "pclk_mailbox";
			#mbox-cells = <1>;
			status = "disabled";
		};

		mailbox2: mailbox@fcc20000 {
			compatible = "rockchip,rk3538-mailbox", "rockchip,rk3576-mailbox";
			reg = <0xfcc20000 0x40>;
			interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_MAILBOX>;
			clock-names = "pclk_mailbox";
			#mbox-cells = <1>;
			status = "disabled";
		};

		mailbox3: mailbox@fcc30000 {
			compatible = "rockchip,rk3538-mailbox", "rockchip,rk3576-mailbox";
			reg = <0xfcc30000 0x40>;
			interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_MAILBOX>;
			clock-names = "pclk_mailbox";
			#mbox-cells = <1>;
			status = "disabled";
		};

		rktimer: timer@fce00000 {
			compatible = "rockchip,rk3538-timer", "rockchip,rk3288-timer";
			reg = <0xfce00000 0x1000>;
			interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_TIMER>, <&cru CLK_TIMER0>;
			clock-names = "pclk", "timer";
		};

		cru: clock-controller@fd000000 {
			compatible = "rockchip,rk3538-cru";
			reg = <0xfd000000 0x91000>;
			#clock-cells = <1>;
			#reset-cells = <1>;

			assigned-clocks =
				<&cru PLL_GPLL>,
				<&cru CLK_UART_FRAC_0_SRC>, <&cru CLK_UART_FRAC_1_SRC>,
				<&cru CLK_AUDIO_FRAC_0_SRC>, <&cru CLK_AUDIO_FRAC_1_SRC>,
				<&cru CLK_CM_FRAC_0_SRC>, <&cru CLK_CM_FRAC_1_SRC>,
				<&cru CLK_UART_FRAC_0>, <&cru CLK_UART_FRAC_1>,
				<&cru CLK_AUDIO_FRAC_0>, <&cru CLK_AUDIO_FRAC_1>,
				<&cru CLK_CM_FRAC_0>, <&cru CLK_CM_FRAC_1>,
				<&cru CLK_CPLL_DIV10>, <&cru PMU_100M_CLK>;
			assigned-clock-rates =
				<1188000000>,
				<1188000000>, <1188000000>,
				<1188000000>, <1188000000>,
				<1188000000>, <1188000000>,
				<18432000>, <128000000>,
				<45158400>, <49152000>,
				<96000000>, <25000000>,
				<100000000>, <100000000>;
		};

		vo_grf: syscon@fd170000 {
			compatible = "rockchip,rk3538-vo-grf", "syscon";
			reg = <0xfd170000 0x10000>;
			clocks = <&cru PCLK_VO_ROOT>;
		};

		pmu_grf: syscon@fd180000 {
			compatible = "rockchip,rk3538-pmu-grf", "syscon", "simple-mfd";
			reg = <0xfd180000 0x10000>;

			reboot_mode: reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x1000>;
				mode-bootloader = <BOOT_BL_DOWNLOAD>;
				mode-charge = <BOOT_CHARGING>;
				mode-fastboot = <BOOT_FASTBOOT>;
				mode-loader = <BOOT_BL_DOWNLOAD>;
				mode-normal = <BOOT_NORMAL>;
				mode-recovery = <BOOT_RECOVERY>;
				mode-ums = <BOOT_UMS>;
				mode-panic = <BOOT_PANIC>;
				mode-watchdog = <BOOT_WATCHDOG>;
				mode-quiescent = <BOOT_QUIESCENT>;
				/* add a mode to capture the ramdump through usb */
				mode-winusb = <BOOT_WINUSB>;
			};
		};

		phpl_grf: syscon@fd190000 {
			compatible = "rockchip,rk3538-phpl-grf", "syscon";
			reg = <0xfd190000 0x10000>;
		};

		ioc_grf: syscon@fd1b0000 {
