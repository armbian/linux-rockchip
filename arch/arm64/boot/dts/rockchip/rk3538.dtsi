			reg = <0xfd4a0100 0x20>;
		};

		shaping_fspi: shaping@fd4a0188 {
			compatible = "syscon";
			reg = <0xfd4a0188 0x4>;
		};

		qos_nand: qos@fd4a0200 {
			compatible = "syscon";
			reg = <0xfd4a0200 0x20>;
		};

		shaping_nand: shaping@fd4a0288 {
