/dts-v1/;

#include "rk3538.dtsi"
#include "rk3538-evb.dtsi"

/{
	vcc12v_dcin: vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vdd_logic: vdd-logc {
		compatible = "pwm-regulator";
		pwms = <&pwm0_4ch_2 0 25000 1>;
		regulator-name = "vdd_logic";
		regulator-init-microvolt = <901000>;
		regulator-min-microvolt = <703000>;
		regulator-max-microvolt = <1006000>;
		regulator-settling-time-up-us = <250>;
		regulator-always-on;
		regulator-boot-on;
		pwm-supply = <&vcc5v0_sys>;
	};

	vdd_cpu: vdd-cpu {
		compatible = "pwm-regulator";
		pwms = <&pwm0_4ch_3 0 25000 1>;
		regulator-name = "vdd_cpu";
		regulator-init-microvolt = <953000>;
		regulator-min-microvolt = <746000>;
		regulator-max-microvolt = <1200000>;
		regulator-settling-time-up-us = <250>;
		regulator-always-on;
		regulator-boot-on;
		pwm-supply = <&vcc5v0_sys>;
	};

	vcc_ddr: vcc-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ddr";
		regulator-min-microvolt = <1250000>;
		regulator-max-microvolt = <1250000>;
		enable-active-low;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_pmu: vcc3v3-pmu {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pmu";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-low;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_3v3: vcc_3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-low;
		regulator-boot-on;
		vin-supply = <&vcc3v3_pmu>;
	};

	vcc1v8_pmu: vcc1v8-pmu {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8_pmu";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-low;
		regulator-boot-on;
		vin-supply = <&vcc3v3_pmu>;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-low;
		regulator-boot-on;
		vin-supply = <&vcc1v8_pmu>;
	};
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&gpu {
	mali-supply = <&vdd_logic>;
};

&mac {
	status = "okay";
};

&pwm0_4ch_2 {
	status = "okay";
};

&pwm0_4ch_3 {
	pinctrl-0 = <&pwm0m1_ch3_pins>;
	status = "okay";
};
