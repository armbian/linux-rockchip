#include "rk3538.dtsi"

/ {
	compatible = "rockchip,rk3539";

	interrupt-parent = <&gic>;
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		ethernet0 = &gmac;
	};

	soc {
		gmac: ethernet@fdd80000 {
			compatible = "rockchip,rk3538-gmac", "snps,dwmac-4.20a";
			reg = <0xfdd80000 0x10000>;
			interrupts = <GIC_SPI 127 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_wake_irq";
			rockchip,grf = <&phpl_grf>;
			clocks = <&cru CLK_GMAC_125M>, <&cru CLK_GMAC_50M_IOBUF>,
				 <&cru PCLK_GMAC>, <&cru ACLK_GMAC>,
				 <&cru CLK_GMAC_PTP_REF>;
			clock-names = "stmmaceth", "clk_mac_ref",
				      "pclk_mac", "aclk_mac",
				      "ptp_ref";
			resets = <&cru SRST_ARESETN_GMAC>;
			reset-names = "stmmaceth";

			snps,mixed-burst;
			snps,tso;

			snps,axi-config = <&gmac_stmmac_axi_setup>;
			snps,mtl-rx-config = <&gmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac_mtl_tx_setup>;

			status = "disabled";

			mdio0: mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			gmac_stmmac_axi_setup: stmmac-axi-config {
				snps,wr_osr_lmt = <4>;
				snps,rd_osr_lmt = <8>;
				snps,blen = <0 0 0 0 16 8 4>;
			};

			gmac_mtl_rx_setup: rx-queues-config {
				snps,rx-queues-to-use = <1>;
				queue0 {};
			};

			gmac_mtl_tx_setup: tx-queues-config {
				snps,tx-queues-to-use = <1>;
				queue0 {};
			};
		};
	};
};

&cpu01_opp_table {
	opp-1608000000 {
		opp-hz = /bits/ 64 <1608000000>;
		opp-microvolt = <1012500 1012500 1100000>;
		opp-microvolt-L1 = <1000000 1000000 1100000>;
		opp-microvolt-L2 = <987500 987500 1100000>;
		opp-microvolt-L3 = <975000 975000 1100000>;
		opp-microvolt-L4 = <975000 975000 1100000>;
		opp-microvolt-L5 = <962500 962500 1100000>;
		opp-microvolt-L6 = <950000 950000 1100000>;
		clock-latency-ns = <40000>;
	};
	opp-1800000000 {
		opp-hz = /bits/ 64 <1800000000>;
		opp-microvolt = <1087500 1087500 1100000>;
		opp-microvolt-L1 = <1075000 1075000 1100000>;
		opp-microvolt-L2 = <1062500 1062500 1100000>;
		opp-microvolt-L3 = <1050000 1050000 1100000>;
		opp-microvolt-L4 = <1037500 1037500 1100000>;
		opp-microvolt-L5 = <1025000 1025000 1100000>;
		opp-microvolt-L6 = <1012500 1012500 1100000>;
		clock-latency-ns = <40000>;
	};
};

&cpu23_opp_table {
	opp-1608000000 {
		opp-hz = /bits/ 64 <1608000000>;
		opp-microvolt = <1012500 1012500 1100000>;
		opp-microvolt-L1 = <1000000 1000000 1100000>;
		opp-microvolt-L2 = <987500 987500 1100000>;
		opp-microvolt-L3 = <975000 975000 1100000>;
		opp-microvolt-L4 = <975000 975000 1100000>;
		opp-microvolt-L5 = <962500 962500 1100000>;
		opp-microvolt-L6 = <950000 950000 1100000>;
		clock-latency-ns = <40000>;
	};
	opp-1800000000 {
		opp-hz = /bits/ 64 <1800000000>;
		opp-microvolt = <1087500 1087500 1100000>;
		opp-microvolt-L1 = <1075000 1075000 1100000>;
		opp-microvolt-L2 = <1062500 1062500 1100000>;
		opp-microvolt-L3 = <1050000 1050000 1100000>;
		opp-microvolt-L4 = <1037500 1037500 1100000>;
		opp-microvolt-L5 = <1025000 1025000 1100000>;
		opp-microvolt-L6 = <1012500 1012500 1100000>;
		clock-latency-ns = <40000>;
	};
	opp-1920000000 {
		opp-hz = /bits/ 64 <1920000000>;
		opp-microvolt = <1100000 1100000 1100000>;
		opp-microvolt-L3 = <1087500 1087500 1100000>;
		opp-microvolt-L4 = <1075000 1075000 1100000>;
		opp-microvolt-L5 = <1062500 1062500 1100000>;
		opp-microvolt-L6 = <1050000 1050000 1100000>;
		clock-latency-ns = <40000>;
	};
};

&gpu_opp_table {
	opp-550000000 {
		opp-hz = /bits/ 64 <550000000>;
		opp-microvolt = <925000 925000 950000>;
		opp-microvolt-L1 = <912500 912500 950000>;
		opp-microvolt-L2 = <900000 900000 950000>;
		opp-microvolt-L3 = <887500 887500 950000>;
	};
};

&soc_thermal {
	sustainable-power = <452>; /* milliwatts */
};
