/dts-v1/;
/plugin/;
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	fragment@0 {
		target = <&spi1>;

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&spi1m1_csn0 &spi1m1_csn1 &spi1m1_pins>;
			num-cs = <2>;

			spidev@0 {
				compatible = "spidev";
				reg = <0>;
				spi-max-frequency = <50000000>;
				status = "okay";
			};

			spidev@1 {
				compatible = "spidev";
				reg = <1>;
				spi-max-frequency = <50000000>;
				status = "okay";
			};
		};
	};
};
