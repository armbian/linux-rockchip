&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	rockchip,typec-vbus-det;
	status = "okay";
};

/* USB 2.0 PHY1 */
&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
};

