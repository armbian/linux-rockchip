&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

/* USB 2.0 PHY3 for HOST 1 */
&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

/* USB 3.0 & DP PHY0 */
&usbdp_phy0 {
	orientation-switch;
	svid = <0xff01>;
	pinctrl-names = "default";
	pinctrl-0 = <&usbc0_sbu1 &usbc0_sbu2>;
	sbu1-dc-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
	sbu2-dc-gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		usbdp_phy0_orientation_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_orien_sw>;
		};

		usbdp_phy0_dp_altmode_mux: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&dp_altmode_mux>;
		};
	};
};

&usbdp_phy0_dp {
	status = "okay";
};

&usbdp_phy0_u3 {
	status = "okay";
};

/* USB 3.0 & DP PHY1 */
&usbdp_phy1 {
	status = "okay";
};

&usbdp_phy1_dp {
	status = "okay";
};

&usbdp_phy1_u3 {
	status = "okay";
};

/* USB OTG Controller 0, Left USB 3.0 Type-C */
&usbdrd3_0 {
	status = "okay";
};

&usbdrd_dwc3_0 {
	dr_mode = "otg";
	usb-role-switch;
	extcon = <&u2phy0>;
	status = "okay";
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		dwc3_0_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

/* USB OTG Controller 0, Left USB 3.0 Type-A */
&usbdrd3_1 {
	status = "okay";
};

&usbdrd_dwc3_1 {
	dr_mode = "host";
	status = "okay";
};

/* USB 2.0 Controller for HOST 0, USB Camera */
&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

/* USB 2.0 Controller for HOST 1, USB Keyboard, Right dual USB 2.0 Type-A  */
&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

/* pcie2x1l1/sata2/usbhost_dwc3_0 Combo PHY */
&combphy2_psu {
	status = "okay";
};

/* USB 3.0 Controller for HOST 2 */
&usbhost3_0 {
	status = "okay";
};

&usbhost_dwc3_0 {
	dr_mode = "host";
	status = "okay";
};

&vcc_1v8_s0 {
	regulator-always-on;
	regulator-boot-on;
	regulator-state-mem {
		regulator-off-in-suspend;
		regulator-on-in-suspend;
		regulator-suspend-microvolt = <1800000>;
	};
};

&vcc_3v3_s0 {
	regulator-always-on;
	regulator-boot-on;
	regulator-state-mem {
		regulator-off-in-suspend;
		regulator-on-in-suspend;
		regulator-suspend-microvolt = <3300000>;
	};
};

&vdd_ddr_s0 {
	regulator-min-microvolt = <850000>;
	regulator-max-microvolt = <900000>;
};

&vdd_log_s0 {
	regulator-min-microvolt = <750000>;
	regulator-max-microvolt = <800000>;
};

&vdpu {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&vepu {
	status = "okay";
};

&vop {
	disable-win-move;
	/*
	 * dclk_vop2_src has neither CLK_SET_RATE_PARENT nor a fractional
	 * divider, so the VOP can only divide its parent: keep V0PLL on an
	 * exact multiple of the panel's 141 MHz pixel clock (8 x 141 MHz =
	 * 1128 MHz, added to the PLL table by the clk patch).
	 */
	assigned-clocks = <&cru PLL_V0PLL>,
			  <&cru DCLK_VOP0_SRC>,
			  <&cru DCLK_VOP1_SRC>,
			  <&cru DCLK_VOP2_SRC>,
			  <&cru DCLK_VOP3>;
	assigned-clock-rates = <1128000000>, <0>, <0>, <141000000>, <0>;
	assigned-clock-parents = <0>, <0>, <0>, <&cru PLL_V0PLL>, <0>;
	vop-supply = <&vdd_log_s0>;
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

/* vp0 & vp1 splice for 8K output */
&vp0 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER0 | 1 << ROCKCHIP_VOP2_ESMART0)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART0>;
};

&vp1 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER1 | 1 << ROCKCHIP_VOP2_ESMART1)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART1>;
};

&vp2 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER2 | 1 << ROCKCHIP_VOP2_ESMART2)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART2>;
};

&vp3 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER3 | 1 << ROCKCHIP_VOP2_ESMART3)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART3>;
};
