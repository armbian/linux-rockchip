&csi2_dphy3 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			dphy3_in_ucam0: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&dphy3_imx415_out0>;
				data-lanes = <1 2 3 4>;
			};

			dphy3_in_ucam1: endpoint@2 {
				reg = <2>;
				remote-endpoint = <&dphy3_imx464_out0>;
				data-lanes = <1 2>;
			};

			dphy3_in_ucam2: endpoint@3 {
				reg = <3>;
				remote-endpoint = <&dphy3_imx464_out1>;
				data-lanes = <1 2>;
			};

			dphy3_in_ucam3: endpoint@4 {
				reg = <4>;
				remote-endpoint = <&dphy3_sc4336_out>;
				data-lanes = <1 2>;
			};

			dphy3_in_ucam4: endpoint@5 {
				reg = <5>;
				remote-endpoint = <&dphy3_os04a10_out>;
				data-lanes = <1 2>;
			};

			dphy3_in_ucam5: endpoint@6 {
				reg = <6>;
				remote-endpoint = <&dphy3_sc850sl_out>;
				data-lanes = <1 2 3 4>;
			};

			dphy3_in_ucam6: endpoint@7 {
				reg = <7>;
				remote-endpoint = <&dphy3_ov50c40_out>;
				data-lanes = <1 2 3 4>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy3_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi2_csi2_input>;
			};
		};
	};
};

&i2c5 {
	status = "okay";
	pinctrl-0 = <&i2c5m3_xfer_pins>;

	dphy3_aw8601: dphy3-aw8601@c {
		compatible = "awinic,aw8601";
		status = "okay";
		reg = <0x0c>;
		rockchip,vcm-start-current = <56>;
		rockchip,vcm-rated-current = <96>;
		rockchip,vcm-step-mode = <4>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
	};

	dphy3_imx415: dphy3-imx415@1a {
		compatible = "sony,imx415";
		reg = <0x1a>;
		clocks = <&cru CAM_CLK2_OUT_IOUT>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk2m0_clk2_pins>;
		power-domains = <&power RK3572_PD_VI>;
		/* reset need connect to dovdd */
		avdd-supply = <&vcc_mipicsi1>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "CMK-OT2022-PX1";
		rockchip,camera-module-lens-name = "IR0147-50IRC-8M-F20";
		port {
			dphy3_imx415_out0: endpoint {
				remote-endpoint = <&dphy3_in_ucam0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	dphy3_imx464_0: dphy3-imx464-0@1a {
		compatible = "sony,imx464";
		status = "okay";
		reg = <0x1a>;
		clocks = <&cru CAM_CLK2_OUT_IOUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3572_PD_VI>;
		/* reset need connect to dovdd */
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk2m0_clk2_pins>;
		avdd-supply = <&vcc_mipicsi1>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "CMK-OT1980-PX1";
		rockchip,camera-module-lens-name = "SHG102";
		port {
			dphy3_imx464_out0: endpoint {
				remote-endpoint = <&dphy3_in_ucam1>;
				data-lanes = <1 2>;
			};
		};
	};

	dphy3_sc4336: dphy3-sc4336@30 {
		compatible = "smartsens,sc4336";
		status = "okay";
		reg = <0x30>;
		clocks = <&cru CAM_CLK2_OUT_IOUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3572_PD_VI>;
		pinctrl-names = "default";
		/* reset need connect to dovdd */
		pwdn-gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&cam_clk2m0_clk2_pins>;
		avdd-supply = <&vcc_mipicsi1>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "OT01";
		rockchip,camera-module-lens-name = "40IRC_F16";
		port {
			dphy3_sc4336_out: endpoint {
				remote-endpoint = <&dphy3_in_ucam3>;
				data-lanes = <1 2>;
			};
		};
	};

	dphy3_sc850sl: dphy3-sc850sl@30 {
		compatible = "smartsens,sc850sl";
		status = "okay";
		reg = <0x30>;
		clocks = <&cru CAM_CLK2_OUT_IOUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3572_PD_VI>;
		pinctrl-names = "default";
		/* reset need connect to dovdd */
		pwdn-gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&cam_clk2m0_clk2_pins>;
		avdd-supply = <&vcc_mipicsi1>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "default";
		rockchip,camera-module-lens-name = "default";
		port {
			dphy3_sc850sl_out: endpoint {
				remote-endpoint = <&dphy3_in_ucam5>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	dphy3_imx464_1: dphy3-imx464-1@36 {
		compatible = "sony,imx464";
		status = "okay";
		reg = <0x36>;
		clocks = <&cru CAM_CLK2_OUT_IOUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3572_PD_VI>;
		pinctrl-names = "default";
		/* reset need connect to dovdd */
		pinctrl-0 = <&cam_clk2m0_clk2_pins>;
		avdd-supply = <&vcc_mipicsi1>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "CMK-OT1980-PX1";
		rockchip,camera-module-lens-name = "SHG102";
		port {
			dphy3_imx464_out1: endpoint {
				remote-endpoint = <&dphy3_in_ucam2>;
				data-lanes = <1 2>;
			};
		};
	};

	dphy3_os04a10: dphy3-os04a10@36 {
		compatible = "ovti,os04a10";
		status = "okay";
		reg = <0x36>;
		clocks = <&cru CAM_CLK2_OUT_IOUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3572_PD_VI>;
		pinctrl-names = "default";
		/* reset need connect to dovdd */
		pwdn-gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&cam_clk2m0_clk2_pins>;
		avdd-supply = <&vcc_mipicsi1>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "CMK-OT1607-FV1";
		rockchip,camera-module-lens-name = "M12-40IRC-4MP-F16";
		port {
			dphy3_os04a10_out: endpoint {
				remote-endpoint = <&dphy3_in_ucam4>;
				data-lanes = <1 2>;
			};
		};
	};

	dphy3_ov50c40: dphy3-ov50c40@36 {
		compatible = "ovti,ov50c40";
		status = "okay";
		reg = <0x36>;
		clocks = <&cru CAM_CLK2_OUT_IOUT>;
		clock-names = "xvclk";
		power-domains = <&power RK3572_PD_VI>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk2m0_clk2_pins>;
		pwdn-gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
		avdd-supply = <&vcc_mipicsi1>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "HZGA06";
		rockchip,camera-module-lens-name = "ZE0082C1";
		eeprom-ctrl = <&dphy3_otp_eeprom>;
		lens-focus = <&dphy3_aw8601>;
		port {
			dphy3_ov50c40_out: endpoint {
				remote-endpoint = <&dphy3_in_ucam6>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	dphy3_otp_eeprom: dphy3-otp_eeprom@50 {
		compatible = "rk,otp_eeprom";
		status = "okay";
		reg = <0x50>;
	};

};

&mipi2_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi2_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy3_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi2_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi2_in0>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds2 {
	status = "okay";

	port {
		cif_mipi2_in0: endpoint {
			remote-endpoint = <&mipi2_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds2_sditf {
	status = "okay";

	port {
		mipi2_lvds_sditf: endpoint {
			remote-endpoint = <&isp_vir1>;
		};
	};
};

&rkcif_mmu {
	status = "okay";
};

&rkisp {
	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkisp_vir1 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir1: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi2_lvds_sditf>;
		};
	};
};

&rkisp_vir1_sditf {
	status = "okay";
};

&rkvpss {
	status = "okay";
};

&rkvpss_mmu {
	status = "okay";
};

&rkvpss_vir1 {
	status = "okay";
};
