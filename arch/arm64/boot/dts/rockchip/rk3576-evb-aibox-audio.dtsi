&sai1 {
	status = "okay";
	rockchip,tdm-tx-lanes = <1>;
	rockchip,tdm-rx-lanes = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&sai1m0_lrck
		&sai1m0_sclk
		&sai1m0_sdi0
		&sai1m0_sdo0>;
};

&pdm1 {
	status = "okay";
	pinctrl-names = "default", "idle", "clk";
	pinctrl-0 = <&pdm1m0_sdi0
		&pdm1m0_sdi1
		&pdm1m0_sdi2
		&pdm1m0_sdi3>;
	pinctrl-1 = <&pdm1m0_clk0_idle
		&pdm1m0_clk1_idle>;
	pinctrl-2 = <&pdm1m0_clk0
		&pdm1m0_clk1>;
};

