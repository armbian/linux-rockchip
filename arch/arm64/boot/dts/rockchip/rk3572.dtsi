#include <dt-bindings/clock/rockchip,rk3572-cru.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/power/rockchip,rk3572-power-controller.h>
#include <dt-bindings/reset/rockchip,rk3572-cru.h>
#include <dt-bindings/soc/rockchip,boot-mode.h>

/ {
	compatible = "rockchip,rk3572";

	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		csi2dphy0 = &csi2_dphy0;
		csi2dphy1 = &csi2_dphy1;
		csi2dphy2 = &csi2_dphy2;
		csi2dphy3 = &csi2_dphy3;
		csi2dphy4 = &csi2_dphy4;
		csi2dphy5 = &csi2_dphy5;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		gpio0 = &gpio0;
		gpio1 = &gpio1;
		gpio2 = &gpio2;
		gpio3 = &gpio3;
		gpio4 = &gpio4;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		i2c9 = &i2c9;
		i3c0 = &i3c;
		rkcif_mipi_lvds0 = &rkcif_mipi_lvds;
		rkcif_mipi_lvds1 = &rkcif_mipi_lvds1;
		rkcif_mipi_lvds2 = &rkcif_mipi_lvds2;
		rkcif_mipi_lvds3 = &rkcif_mipi_lvds3;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		serial9 = &uart9;
		serial10 = &uart10;
		serial11 = &uart11;
		spi0 = &spi0;
		spi1 = &spi1;
		spi2 = &spi2;
		spi3 = &spi3;
		spi4 = &spi4;
		spi5 = &fspi0;
		spi6 = &fspi1;
	};

	clocks {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		clk_rcosc: clk_rcosc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
			clock-output-names = "clk_rcosc";
		};

		spll: spll {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <702000000>;
			clock-output-names = "spll";
		};

		xin24m: xin24m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
			clock-output-names = "xin24m";
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu_l0>;
				};
				core1 {
					cpu = <&cpu_l1>;
				};
				core2 {
					cpu = <&cpu_l2>;
				};
				core3 {
					cpu = <&cpu_l3>;
				};
			};
			cluster1 {
				core0 {
					cpu = <&cpu_l4>;
				};
				core1 {
					cpu = <&cpu_l5>;
				};
			};
			cluster2 {
				core0 {
					cpu = <&cpu_b0>;
				};
				core1 {
					cpu = <&cpu_b1>;
				};
			};
		};

		cpu_l0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0>;
			enable-method = "psci";
		};

		cpu_l1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x1>;
			enable-method = "psci";
		};

		cpu_l2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x2>;
			enable-method = "psci";
		};

		cpu_l3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x3>;
			enable-method = "psci";
		};

		cpu_l4: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			enable-method = "psci";
		};

		cpu_l5: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			enable-method = "psci";
		};

		cpu_b0: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x200>;
			enable-method = "psci";
		};

		cpu_b1: cpu@201 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x201>;
			enable-method = "psci";
		};
	};

	cpuinfo {
		compatible = "rockchip,cpuinfo";
		nvmem-cells = <&otp_id>, <&otp_cpu_version>, <&cpu_code>;
		nvmem-cell-names = "id", "cpu-version", "cpu-code";
	};

	/* dphy0 full mode */
	csi2_dphy0: csi2-dphy0 {
		compatible = "rockchip,rk3572-csi2-dphy";
		rockchip,hw = <&csi2_dphy0_hw>, <&csi2_dphy1_hw>;
		status = "disabled";
	};

	/* dphy0 split mode 01 */
	csi2_dphy1: csi2-dphy1 {
		compatible = "rockchip,rk3572-csi2-dphy";
		rockchip,hw = <&csi2_dphy0_hw>, <&csi2_dphy1_hw>;
		status = "disabled";
	};

	/* dphy0 split mode 23 */
	csi2_dphy2: csi2-dphy2 {
		compatible = "rockchip,rk3572-csi2-dphy";
		rockchip,hw = <&csi2_dphy0_hw>, <&csi2_dphy1_hw>;
		status = "disabled";
	};

	/* dphy1 full mode */
	csi2_dphy3: csi2-dphy3 {
		compatible = "rockchip,rk3572-csi2-dphy";
		rockchip,hw = <&csi2_dphy0_hw>, <&csi2_dphy1_hw>;
		status = "disabled";
	};

	/* dphy1 split mode 01 */
	csi2_dphy4: csi2-dphy4 {
		compatible = "rockchip,rk3572-csi2-dphy";
		rockchip,hw = <&csi2_dphy0_hw>, <&csi2_dphy1_hw>;
		status = "disabled";
	};

	/* dphy1 split mode 23 */
	csi2_dphy5: csi2-dphy5 {
		compatible = "rockchip,rk3572-csi2-dphy";
		rockchip,hw = <&csi2_dphy0_hw>, <&csi2_dphy1_hw>;
		status = "disabled";
	};

	display_subsystem: display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <&vop_out>;

		route {
			route_rgb: route-rgb {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp1_out_rgb>;
			};

			route_dsi: route-dsi {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp1_out_dsi>;
			};

			route_edp: route-edp {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp1_out_edp>;
			};

			route_hdmi: route-hdmi {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp0_out_hdmi>;
			};
		};
	};

	firmware {
		scmi: scmi {
			compatible = "arm,scmi-smc";
			arm,smc-id = <0x82000010>;
			shmem = <&scmi_shmem>;
			#address-cells = <1>;
			#size-cells = <0>;

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;
			};
		};
	};

	mipi0_csi2: mipi0-csi2 {
		compatible = "rockchip,rk3572-mipi-csi2";
		rockchip,hw = <&mipi0_csi2_hw>, <&mipi1_csi2_hw>,
			      <&mipi2_csi2_hw>, <&mipi3_csi2_hw>;
		status = "disabled";
	};

	mipi1_csi2: mipi1-csi2 {
		compatible = "rockchip,rk3572-mipi-csi2";
		rockchip,hw = <&mipi0_csi2_hw>, <&mipi1_csi2_hw>,
			      <&mipi2_csi2_hw>, <&mipi3_csi2_hw>;
		status = "disabled";
	};

	mipi2_csi2: mipi2-csi2 {
		compatible = "rockchip,rk3572-mipi-csi2";
		rockchip,hw = <&mipi0_csi2_hw>, <&mipi1_csi2_hw>,
			      <&mipi2_csi2_hw>, <&mipi3_csi2_hw>;
		status = "disabled";
	};

	mipi3_csi2: mipi3-csi2 {
		compatible = "rockchip,rk3572-mipi-csi2";
		rockchip,hw = <&mipi0_csi2_hw>, <&mipi1_csi2_hw>,
			      <&mipi2_csi2_hw>, <&mipi3_csi2_hw>;
		status = "disabled";
	};

	mpp_srv: mpp-srv {
		compatible = "rockchip,mpp-service";
		rockchip,taskqueue-count = <4>;
		rockchip,resetgroup-count = <4>;
		status = "disabled";
	};

	pinctrl: pinctrl {
		compatible = "rockchip,rk3572-pinctrl";
		rockchip,grf = <&ioc_grf>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gpio0: gpio@26300000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x26300000 0x0 0x200>;
			interrupts = <GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO0>, <&cru DBCLK_GPIO0>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 0 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio1: gpio@2b200000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x2b200000 0x0 0x200>;
			interrupts = <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO1>, <&cru DBCLK_GPIO1>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 32 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio2: gpio@2b300000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x2b300000 0x0 0x200>;
			interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 114 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO2>, <&cru DBCLK_GPIO2>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 64 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio3: gpio@2b400000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x2b400000 0x0 0x200>;
			interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO3>, <&cru DBCLK_GPIO3>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 96 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio4: gpio@2b500000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x2b500000 0x0 0x200>;
			interrupts = <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 121 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 122 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO4>, <&cru DBCLK_GPIO4>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 128 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};

	pmu_a53: pmu-cluster0 {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu_l0>, <&cpu_l1>, <&cpu_l2>, <&cpu_l3>,
				     <&cpu_l4>, <&cpu_l5>;
	};

	pmu_a73: pmu-cluster2 {
		compatible = "arm,cortex-a73-pmu";
		interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu_b0>, <&cpu_b1>;
	};

	psci: psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	rkcif_dvp: rkcif-dvp {
		compatible = "rockchip,rkcif-dvp";
		rockchip,hw = <&rkcif>;
		status = "disabled";
	};

	rkcif_dvp_sditf: rkcif-dvp-sditf {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_dvp>;
		status = "disabled";
	};

	rkcif_mipi_lvds: rkcif-mipi-lvds {
		compatible = "rockchip,rkcif-mipi-lvds";
		rockchip,hw = <&rkcif>;
		status = "disabled";
	};

	rkcif_mipi_lvds_sditf: rkcif-mipi-lvds-sditf {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds>;
		status = "disabled";
	};

	rkcif_mipi_lvds_sditf_vir1: rkcif-mipi-lvds-sditf-vir1 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds>;
		status = "disabled";
	};

	rkcif_mipi_lvds_sditf_vir2: rkcif-mipi-lvds-sditf-vir2 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds>;
		status = "disabled";
	};

	rkcif_mipi_lvds_sditf_vir3: rkcif-mipi-lvds-sditf-vir3 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds>;
		status = "disabled";
	};

	rkcif_mipi_lvds1: rkcif-mipi-lvds1 {
		compatible = "rockchip,rkcif-mipi-lvds";
		rockchip,hw = <&rkcif>;
		status = "disabled";
	};

	rkcif_mipi_lvds1_sditf: rkcif-mipi-lvds1-sditf {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds1>;
		status = "disabled";
	};

	rkcif_mipi_lvds1_sditf_vir1: rkcif-mipi-lvds1-sditf-vir1 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds1>;
		status = "disabled";
	};

	rkcif_mipi_lvds1_sditf_vir2: rkcif-mipi-lvds1-sditf-vir2 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds1>;
		status = "disabled";
	};

	rkcif_mipi_lvds1_sditf_vir3: rkcif-mipi-lvds1-sditf-vir3 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds1>;
		status = "disabled";
	};

	rkcif_mipi_lvds2: rkcif-mipi-lvds2 {
		compatible = "rockchip,rkcif-mipi-lvds";
		rockchip,hw = <&rkcif>;
		status = "disabled";
	};

	rkcif_mipi_lvds2_sditf: rkcif-mipi-lvds2-sditf {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds2>;
		status = "disabled";
	};

	rkcif_mipi_lvds2_sditf_vir1: rkcif-mipi-lvds2-sditf-vir1 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds2>;
		status = "disabled";
	};

	rkcif_mipi_lvds2_sditf_vir2: rkcif-mipi-lvds2-sditf-vir2 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds2>;
		status = "disabled";
	};

	rkcif_mipi_lvds2_sditf_vir3: rkcif-mipi-lvds2-sditf-vir3 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds2>;
		status = "disabled";
	};

	rkcif_mipi_lvds3: rkcif-mipi-lvds3 {
		compatible = "rockchip,rkcif-mipi-lvds";
		rockchip,hw = <&rkcif>;
		status = "disabled";
	};

	rkcif_mipi_lvds3_sditf: rkcif-mipi-lvds3-sditf {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds3>;
		status = "disabled";
	};

	rkcif_mipi_lvds3_sditf_vir1: rkcif-mipi-lvds3-sditf-vir1 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds3>;
		status = "disabled";
	};

	rkcif_mipi_lvds3_sditf_vir2: rkcif-mipi-lvds3-sditf-vir2 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds3>;
		status = "disabled";
	};

	rkcif_mipi_lvds3_sditf_vir3: rkcif-mipi-lvds3-sditf-vir3 {
		compatible = "rockchip,rkcif-sditf";
		rockchip,cif = <&rkcif_mipi_lvds3>;
		status = "disabled";
	};

	rkisp_vir0: rkisp-vir0 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	rkisp_vir1: rkisp-vir1 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	rkisp_vir2: rkisp-vir2 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	rkisp_vir3: rkisp-vir3 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	rkisp_vir4: rkisp-vir4 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	thermal_zones: thermal-zones {
		soc_thermal: soc-thermal {
			polling-delay-passive = <20>; /* milliseconds */
			polling-delay = <1000>; /* milliseconds */
			thermal-sensors = <&tsadc 0>;

			trips {
				soc_crit: soc-crit {
					/* millicelsius */
					temperature = <115000>;
					/* millicelsius */
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		gpu_npu_thermal: gpu-npu-thermal {
			polling-delay-passive = <20>; /* milliseconds */
			polling-delay = <1000>; /* milliseconds */
			thermal-sensors = <&tsadc 1>;

			trips {
				gpu_npu_crit: gpu-npu-crit {
					/* millicelsius */
					temperature = <115000>;
					/* millicelsius */
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		ddr_thermal: ddr-thermal {
			polling-delay-passive = <20>; /* milliseconds */
			polling-delay = <1000>; /* milliseconds */
			thermal-sensors = <&tsadc 2>;

			trips {
				ddr_crit: ddr-crit {
					/* millicelsius */
					temperature = <115000>;
					/* millicelsius */
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		littlecore_thermal: littlecore-thermal {
			polling-delay-passive = <20>;
			polling-delay = <1000>; /* milliseconds */
			thermal-sensors = <&tsadc 3>;

			trips {
				littlecore_crit: littlecore-crit {
					/* millicelsius */
					temperature = <115000>;
					/* millicelsius */
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		bigcore_thermal: bigcore-thermal {
			polling-delay-passive = <20>; /* milliseconds */
			polling-delay = <1000>; /* milliseconds */
			thermal-sensors = <&tsadc 4>;

			trips {
				bigcore_crit: bigcore-crit {
					/* millicelsius */
					temperature = <115000>;
					/* millicelsius */
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		usb_drd0_dwc3: usb@24000000 {
			compatible = "rockchip,rk3572-dwc3", "rockchip,rk3576-dwc3", "snps,dwc3";
			reg = <0x0 0x24000000 0x0 0x400000>;
			clocks = <&cru CLK_REF_USB3OTG0>,
				 <&cru CLK_SUSPEND_USB3OTG0>,
				 <&cru ACLK_USB3OTG0>;
			clock-names = "ref", "suspend", "bus_clk";
			interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&power RK3572_PD_PHP>;
			resets = <&cru SRST_ARESETN_USB3OTG0>;
			reset-names = "usb3-otg";
			dr_mode = "otg";
			phys = <&u2phy0_otg>, <&combphy0_psu PHY_TYPE_USB3>;
			phy-names = "usb2-phy", "usb3-phy";
			phy_type = "utmi_wide";
			snps,dis_enblslpm_quirk;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			snps,parkmode-disable-hs-quirk;
			snps,parkmode-disable-ss-quirk;
			status = "disabled";
		};

		usb_drd1_dwc3: usb@24400000 {
			compatible = "rockchip,rk3572-dwc3", "rockchip,rk3576-dwc3", "snps,dwc3";
			reg = <0x0 0x24400000 0x0 0x400000>;
			clocks = <&cru CLK_REF_USB3OTG1>,
				 <&cru CLK_SUSPEND_USB3OTG1>,
				 <&cru ACLK_USB3OTG1>;
			clock-names = "ref", "suspend", "bus_clk";
			interrupts = <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&power RK3572_PD_PHP>;
			resets = <&cru SRST_ARESETN_USB3OTG1>;
			reset-names = "usb3-otg";
			dr_mode = "otg";
			phys = <&u2phy1_otg>, <&combphy1_psu PHY_TYPE_USB3>;
			phy-names = "usb2-phy", "usb3-phy";
			phy_type = "utmi_wide";
			snps,dis_enblslpm_quirk;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			snps,parkmode-disable-hs-quirk;
			snps,parkmode-disable-ss-quirk;
			status = "disabled";
		};

		sata0: sata@24800000 {
			compatible = "rockchip,rk-ahci", "snps,dwc-ahci";
			reg = <0 0x24800000 0 0x1000>;
			clocks = <&cru ACLK_SATA0>, <&cru CLK_PMALIVE0>, <&cru CLK_RXOOB0>;
			clock-names = "sata", "pmalive", "rxoob";
			interrupts = <GIC_SPI 255 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "hostc";
			power-domains = <&power RK3572_PD_PHP>;
			phys = <&combphy0_psu PHY_TYPE_SATA>;
			phy-names = "sata-phy";
			ports-implemented = <0x1>;
			dma-coherent;
			status = "disabled";
		};

		sata1: sata@24810000 {
			compatible = "rockchip,rk-ahci", "snps,dwc-ahci";
			reg = <0 0x24810000 0 0x1000>;
			clocks = <&cru ACLK_SATA1>, <&cru CLK_PMALIVE1>, <&cru CLK_RXOOB1>;
			clock-names = "sata", "pmalive", "rxoob";
			interrupts = <GIC_SPI 256 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "hostc";
			power-domains = <&power RK3572_PD_PHP>;
			phys = <&combphy2_ps PHY_TYPE_SATA>;
			phy-names = "sata-phy";
			ports-implemented = <0x1>;
			dma-coherent;
			status = "disabled";
		};

		sys_grf: syscon@26010000 {
			compatible = "rockchip,rk3572-sys-grf", "syscon";
			reg = <0x0 0x26010000 0x0 0x2000>;
		};

		vo_grf: syscon@26022000 {
			compatible = "rockchip,rk3572-vo-grf", "syscon";
			reg = <0x0 0x26022000 0x0 0x2000>;
			clocks = <&cru PCLK_VO_ROOT>;
		};

		vi_grf: syscon@26024000 {
			compatible = "rockchip,rk3572-vi-grf", "syscon";
			reg = <0x0 0x26024000 0x0 0x2000>;
		};

		php_grf: syscon@26026000 {
			compatible = "rockchip,rk3572-php-grf", "syscon";
			reg = <0x0 0x26026000 0x0 0x1000>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;
		};

		vop_grf: syscon@26028000 {
			compatible = "rockchip,rk3572-vop-grf", "syscon";
			reg = <0x0 0x26028000 0x0 0x2000>;
		};

		nvm0_grf: syscon@2602a000 {
			compatible = "rockchip,rk3572-nvm0-grf", "syscon";
			reg = <0x0 0x2602a000 0x0 0x1000>;
			clocks = <&cru PCLK_NVM0_ROOT>;
		};

		audio_grf: syscon@2602c000 {
			compatible = "rockchip,rk3572-audio-grf", "syscon";
			reg = <0x0 0x2602c000 0x0 0x1000>;
			clocks = <&cru PCLK_AUDIO_ROOT>;
		};

		dsmc_grf: syscon@2602e000 {
			compatible = "rockchip,rk3572-dsmc-grf", "syscon";
			reg = <0x0 0x2602e000 0x0 0x2000>;
		};

		pmu1_grf: syscon@26042000 {
			compatible = "rockchip,rk3572-pmu1-grf", "syscon", "simple-mfd";
			reg = <0x0 0x26042000 0x0 0x2000>;

			reboot_mode: reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x1000>;
				mode-bootloader = <BOOT_BL_DOWNLOAD>;
				mode-charge = <BOOT_CHARGING>;
				mode-fastboot = <BOOT_FASTBOOT>;
				mode-loader = <BOOT_BL_DOWNLOAD>;
				mode-normal = <BOOT_NORMAL>;
				mode-recovery = <BOOT_RECOVERY>;
				mode-ums = <BOOT_UMS>;
				mode-panic = <BOOT_PANIC>;
				mode-watchdog = <BOOT_WATCHDOG>;
				mode-quiescent = <BOOT_QUIESCENT>;
				/* add a mode to capture the ramdump through usb */
				mode-winusb = <BOOT_WINUSB>;
			};
		};

		pipe_phy0_grf: syscon@2604e000 {
			compatible = "rockchip,rk3572-pipe-phy-grf", "syscon";
			reg = <0x0 0x2604e000 0x0 0x2000>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;
		};

		pipe_phy1_grf: syscon@26050000 {
			compatible = "rockchip,rk3572-pipe-phy-grf", "syscon";
			reg = <0x0 0x26050000 0x0 0x2000>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;
		};

		pipe_phy2_grf: syscon@26052000 {
			compatible = "rockchip,rk3572-pipe-phy-grf", "syscon";
			reg = <0x0 0x26052000 0x0 0x2000>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;
		};

		usb2phy_grf: syscon@26054000 {
			compatible = "rockchip,rk3572-usb2phy-grf", "syscon", "simple-mfd";
			reg = <0x0 0x26054000 0x0 0x4000>;
			#address-cells = <1>;
			#size-cells = <1>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;

			u2phy0: usb2-phy@0 {
				compatible = "rockchip,rk3572-usb2phy";
				reg = <0x0 0x10>;
				resets = <&cru SRST_RESETN_OTGPHY_0>, <&cru SRST_PRESETN_USBPHY_GRF_0>;
				reset-names = "phy", "apb";
				clocks = <&xin24m>;
				clock-names = "phyclk";
				clock-output-names = "usb480m_phy0";
				#clock-cells = <0>;
				rockchip,usbctrl-grf = <&php_grf>;
				status = "disabled";

				u2phy0_otg: otg-port {
					#phy-cells = <0>;
					interrupts = <GIC_SPI 288 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 290 IRQ_TYPE_LEVEL_HIGH>;
					interrupt-names = "otg-bvalid", "otg-id", "linestate";
					status = "disabled";
				};
			};

			u2phy1: usb2-phy@2000 {
				compatible = "rockchip,rk3572-usb2phy";
				reg = <0x2000 0x10>;
				resets = <&cru SRST_RESETN_OTGPHY_1>, <&cru SRST_PRESETN_USBPHY_GRF_1>;
				reset-names = "phy", "apb";
				clocks = <&xin24m>;
				clock-names = "phyclk";
				clock-output-names = "usb480m_phy1";
				#clock-cells = <0>;
				rockchip,usbctrl-grf = <&php_grf>;
				status = "disabled";

				u2phy1_otg: otg-port {
					#phy-cells = <0>;
					interrupts = <GIC_SPI 293 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 295 IRQ_TYPE_LEVEL_HIGH>;
					interrupt-names = "otg-bvalid", "otg-id", "linestate";
					status = "disabled";
				};
			};
		};

		hdptxphy_grf: syscon@26060000 {
			compatible = "rockchip,rk3572-hdptxphy-grf", "syscon";
			reg = <0x0 0x26060000 0x0 0x2000>;
		};

		mipidphyrx0_grf: syscon@26066000 {
			compatible = "rockchip,rk3572-mipidphyrx-grf", "syscon";
			reg = <0x0 0x26066000 0x0 0x2000>;
		};

		mipidphyrx1_grf: syscon@26068000 {
			compatible = "rockchip,rk3572-mipidphyrx-grf", "syscon";
			reg = <0x0 0x26068000 0x0 0x2000>;
		};

		ioc_grf: syscon@26072000 {
			compatible = "rockchip,rk3572-ioc-grf", "syscon", "simple-mfd";
			reg = <0x0 0x26072000 0x0 0x16000>;

			rgb: rgb {
				compatible = "rockchip,rk3572-rgb";
				pinctrl-names = "default";
				status = "disabled";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;

						rgb_in_vp0: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&vp0_out_rgb>;
							status = "disabled";
						};

						rgb_in_vp1: endpoint@1 {
							reg = <1>;
							remote-endpoint = <&vp1_out_rgb>;
							status = "disabled";
						};

						rgb_in_vopl: endpoint@2 {
							reg = <2>;
							remote-endpoint = <&vopl_out_rgb>;
							status = "disabled";
						};
					};
				};
			};
		};

		cru: clock-controller@26090000 {
			compatible = "rockchip,rk3572-cru";
			reg = <0x0 0x26090000 0x0 0x60000>;
			#clock-cells = <1>;
			#reset-cells = <1>;

			assigned-clocks =
				<&cru CLK_AUDIO_FRAC_1_SRC>, <&cru PLL_CPLL>,
				<&cru PLL_AUPLL>, <&cru CLK_UART_FRAC_0>,
				<&cru CLK_UART_FRAC_1>, <&cru CLK_UART_FRAC_2>,
				<&cru CLK_AUDIO_FRAC_0>, <&cru CLK_AUDIO_FRAC_1>,
				<&cru CLK_AUDIO_INT_0>, <&cru CLK_AUDIO_INT_1>,
				<&cru CLK_GPU>;
			assigned-clock-parents = <&cru PLL_AUPLL>;
			assigned-clock-rates =
				<0>, <1000000000>,
				<786432000>, <18432000>,
				<96000000>, <128000000>,
				<45158400>, <49152000>,
				<49152000>, <24576000>,
				<200000000>;
		};

		pwm0_2ch_0: pwm@26200000 {
			compatible = "rockchip,rk3572-pwm", "rockchip,rk3538-pwm";
			reg = <0x0 0x26200000 0x0 0x1000>;
			interrupts = <GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm0m0_ch0_pins>;
			clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>,
				 <&cru CLK_PWM0_OSC>, <&cru CLK_PWM0_RC>;
			clock-names = "pwm", "pclk",
				      "osc", "rc";
			status = "disabled";
		};

		pwm0_2ch_1: pwm@26210000 {
			compatible = "rockchip,rk3572-pwm", "rockchip,rk3538-pwm";
			reg = <0x0 0x26210000 0x0 0x1000>;
			interrupts = <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm0m0_ch1_pins>;
			clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>,
				 <&cru CLK_PWM0_OSC>, <&cru CLK_PWM0_RC>;
			clock-names = "pwm", "pclk",
				      "osc", "rc";
			status = "disabled";
		};

		uart1: serial@26500000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x26500000 0x0 0x100>;
			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART1>, <&cru PCLK_UART1>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 23>, <&dmac0 24>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart1m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		i2c0: i2c@26520000 {
			compatible = "rockchip,rk3572-i2c", "rockchip,rk3399-i2c";
			reg = <0x0 0x26520000 0x0 0x1000>;
			clocks = <&cru CLK_I2C0>, <&cru PCLK_I2C0>;
			clock-names = "i2c", "pclk";
			interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0m0_xfer_pins>;
			resets = <&cru SRST_RESETN_I2C0>, <&cru SRST_PRESETN_I2C0>;
			reset-names = "i2c", "apb";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		pmu: power-management@26550000 {
			compatible = "rockchip,rk3572-pmu", "syscon", "simple-mfd";
			reg = <0x0 0x26550000 0x0 0x1000>;
			rockchip,grf = <&sys_grf>;

			power: power-controller {
				compatible = "rockchip,rk3572-power-controller";
				#power-domain-cells = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "okay";

				/* These power domains are grouped by VD_NPU */
				power-domain@RK3572_PD_NPU {
					reg = <RK3572_PD_NPU>;
					pm_qos = <&qos_rknn>;
				};
				/* These power domains are grouped by VD_GPU */
				power-domain@RK3572_PD_GPU {
					reg = <RK3572_PD_GPU>;
					pm_qos = <&qos_gpu>;
					pm_shaping = <&shaping_gpu>;
				};
				/* These power domains are grouped by VD_LOGIC */
				power-domain@RK3572_PD_NVM1 {
					reg = <RK3572_PD_NVM1>;
					pm_qos = <&qos_fspi1>,
						 <&qos_sdmmc0>;
				};
				power-domain@RK3572_PD_DSMC {
					reg = <RK3572_PD_DSMC>;
					pm_qos = <&qos_dsmc>;
				};
				power-domain@RK3572_PD_PHP {
					reg = <RK3572_PD_PHP>;
					pm_qos = <&qos_gmac0>,
						 <&qos_pcie0>,
						 <&qos_pcie1>,
						 <&qos_sata0>,
						 <&qos_sata1>,
						 <&qos_ufshc>,
						 <&qos_usb0>,
						 <&qos_usb1>;
					pm_shaping = <&shaping_pcie0>,
						     <&shaping_pcie1>;
				};
				power-domain@RK3572_PD_AUDIO {
					reg = <RK3572_PD_AUDIO>;
				};
				power-domain@RK3572_PD_IMG {
					reg = <RK3572_PD_IMG>;
					pm_qos = <&qos_ebc>,
						 <&qos_rga>,
						 <&qos_jpeg>,
						 <&qos_vdpp>;
					pm_shaping = <&shaping_ebc>,
						     <&shaping_rga>,
						     <&shaping_jpeg>,
						     <&shaping_vdpp>;
				};
				power-domain@RK3572_PD_VDEC {
					reg = <RK3572_PD_VDEC>;
					pm_qos = <&qos_vdpu>;
					pm_shaping = <&shaping_vdpu>;
				};
				power-domain@RK3572_PD_VI {
					reg = <RK3572_PD_VI>;
					#address-cells = <1>;
					#size-cells = <0>;
					pm_qos = <&qos_isp_mro>,
						 <&qos_isp_mwo>,
						 <&qos_vicap>,
						 <&qos_vpss_mro>,
						 <&qos_vpss_mwo>;
					pm_shaping = <&shaping_isp_mro>,
						     <&shaping_isp_mwo>,
						     <&shaping_vicap>,
						     <&shaping_vpss_mro>,
						     <&shaping_vpss_mwo>;

					power-domain@RK3572_PD_VENC {
						reg = <RK3572_PD_VENC>;
						pm_qos = <&qos_vepu>;
						pm_shaping = <&shaping_vepu>;
					};
				};
				power-domain@RK3572_PD_VOP {
					reg = <RK3572_PD_VOP>;
					#address-cells = <1>;
					#size-cells = <0>;
					pm_qos = <&qos_vop_m0>,
						 <&qos_vop_m1ro>;
					pm_shaping = <&shaping_vop_m0>,
						     <&shaping_vop_m1ro>;

					power-domain@RK3572_PD_VOP_PRE {
						reg = <RK3572_PD_VOP_PRE>;
					};
					power-domain@RK3572_PD_VO {
						reg = <RK3572_PD_VO>;
						pm_qos = <&qos_hdcp>;
					};
					power-domain@RK3572_PD_NVM0 {
						reg = <RK3572_PD_NVM0>;
						pm_qos = <&qos_emmc>,
							 <&qos_fspi0>,
							 <&qos_gmac1>,
							 <&qos_sdmmc1>;
					};
				};
			};
		};

		pdm0: pdm@26600000 {
			compatible = "rockchip,rk3572-pdm", "rockchip,rk3576-pdm";
			reg = <0x0 0x26600000 0x0 0x1000>;
			interrupts = <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru MCLK_PDM0>, <&cru HCLK_PDM0>, <&cru CLK_PDM0_OUT>;
			clock-names = "pdm_clk", "pdm_hclk", "pdm_clk_out";
			dmas = <&dmac0 16>;
			dma-names = "rx";
			rockchip,pdm-data-shift = <5 5 5 5 5 5 5 5>;
			pinctrl-names = "default", "idle", "clk";
			pinctrl-0 = <&pdmm0_sdi0_pins
				     &pdmm0_sdi1_pins
				     &pdmm0_sdi2_pins
				     &pdmm0_sdi3_pins>;
			pinctrl-1 = <&pdmm0_clk0_idle
				     &pdmm0_clk1_idle>;
			pinctrl-2 = <&pdmm0_clk0_pins
				     &pdmm0_clk1_pins>;
			#sound-dai-cells = <0>;
			sound-name-prefix = "PDM0";
			status = "disabled";
		};

		cci_hwlock0: hwspinlock@26900000 {
			compatible = "rockchip,hwspinlock";
			reg = <0x0 0x26900000 0x0 0x20>;
			#hwlock-cells = <1>;
			rockchip,hwlock-num-locks = <8>;
			rockchip,hwlock-max-user = <0x3f>;
			status = "disabled";
		};

		cci_hwlock1: hwspinlock@26910000 {
			compatible = "rockchip,hwspinlock";
			reg = <0x0 0x26910000 0x0 0x20>;
			#hwlock-cells = <1>;
			rockchip,hwlock-num-locks = <8>;
			rockchip,hwlock-max-user = <0x3f>;
			status = "disabled";
		};

		cci_hwlock2: hwspinlock@26920000 {
			compatible = "rockchip,hwspinlock";
			reg = <0x0 0x26920000 0x0 0x20>;
			#hwlock-cells = <1>;
			rockchip,hwlock-num-locks = <8>;
			rockchip,hwlock-max-user = <0x3f>;
			status = "disabled";
		};

		cci_hwlock3: hwspinlock@26930000 {
			compatible = "rockchip,hwspinlock";
			reg = <0x0 0x26930000 0x0 0x20>;
			#hwlock-cells = <1>;
			rockchip,hwlock-num-locks = <8>;
			rockchip,hwlock-max-user = <0x3f>;
			status = "disabled";
		};

		vopl: vop@27100000 {
			compatible = "rockchip,rk3572-vop-lit";
			reg = <0x0 0x27100000 0x0 0x200>;
			reg-names = "regs";
			interrupts = <GIC_SPI 193 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_EBC>, <&cru DCLK_EBC>, <&cru HCLK_EBC>;
			clock-names = "aclk_vop", "dclk_vop", "hclk_vop";
			power-domains = <&power RK3572_PD_IMG>, <&power RK3572_PD_VO>;
			power-domain-names = "pd0", "pd1";
			rockchip,grf = <&ioc_grf>;
			rockchip,vo0-grf = <&vo_grf>;
			status = "disabled";

			vopl_out: port {
				#address-cells = <1>;
				#size-cells = <0>;

				vopl_out_rgb: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&rgb_in_vopl>;
				};

				vopl_out_dsi: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&dsi_in_vopl>;
				};

				vopl_out_edp: endpoint@2 {
					reg = <2>;
					remote-endpoint = <&edp_in_vopl>;
				};

				vopl_out_hdmi: endpoint@3 {
					reg = <3>;
					//remote-endpoint = <&hdmi_in_vopl>;
				};
			};
		};

