				 <&cru CLK_HDMITX0_EARC>,
				 <&cru CLK_HDMITX0_REF>,
				 <&cru MCLK_SAI4>,
				 <&cru DCLK_VP0>,
				 <&cru DCLK_VP1>,
				 <&cru HCLK_VO_ROOT>,
				 <&hdptxphy_hdmi>;
			clock-names = "pclk",
				      "hpd",
