		vop: vop@27500000 {
			compatible = "rockchip,rk3572-vop";
			reg = <0x0 0x27500000 0x0 0x3c00>,
			      <0x0 0x27505000 0x0 0x1000>,
			      <0x0 0x27506400 0x0 0x800>,
			      <0x0 0x27506c00 0x0 0x300>;
			reg-names = "regs",
				    "gamma_lut",
				    "acm_regs",
				    "sharp_regs";
			interrupts = <GIC_SPI 329 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 328 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 327 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "vop-sys",
					  "vop-vp0",
					  "vop-vp1";
			clocks = <&cru ACLK_VOP>,
				 <&cru HCLK_VOP>,
				 <&cru DCLK_VP0>,
				 <&cru DCLK_VP1>,
				 <&cru DCLK_VP0_SRC>,
				 <&cru DCLK_VP1_SRC>;
			clock-names = "aclk_vop",
				      "hclk_vop",
				      "dclk_vp0",
				      "dclk_vp1",
				      "dclk_src_vp0",
				      "dclk_src_vp1";
			resets = <&cru SRST_DRESETN_VP0>,
				 <&cru SRST_DRESETN_VP1>;
			reset-names = "dclk_vp0",
				      "dclk_vp1";
			rockchip,aclk-normal-mode-rates = <500000000>;
			rockchip,aclk-reset-mode-rates = <594000000>;
			rockchip,aclk-advanced-mode-rates = <702000000>;
			iommus = <&vop_mmu>;
			rockchip,ioc-grf = <&ioc_grf>;
			status = "disabled";

			vop_out: ports {
				#address-cells = <1>;
				#size-cells = <0>;

				vp0: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;

					vp0_out_rgb: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&rgb_in_vp0>;
					};

					vp0_out_dsi: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&dsi_in_vp0>;
					};

					vp0_out_edp: endpoint@2 {
						reg = <2>;
						remote-endpoint = <&edp_in_vp0>;
					};

					vp0_out_hdmi: endpoint@3 {
						reg = <3>;
						remote-endpoint = <&hdmi_in_vp0>;
					};
				};

				vp1: port@1 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <1>;

					vp1_out_rgb: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&rgb_in_vp1>;
					};

					vp1_out_dsi: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&dsi_in_vp1>;
					};

					vp1_out_edp: endpoint@2 {
						reg = <2>;
						remote-endpoint = <&edp_in_vp1>;
					};

					vp1_out_hdmi: endpoint@3 {
						reg = <3>;
						remote-endpoint = <&hdmi_in_vp1>;
					};
				};
			};
		};

		vop_mmu: iommu@27507e00 {
			compatible = "rockchip,iommu-v2";
			reg = <0x0 0x27507e00 0x0 0x100>, <0x0 0x27507f00 0x0 0x100>;
			interrupts = <GIC_SPI 329 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "vop_mmu";
			clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			rockchip,disable-device-link-resume;
			rockchip,shootdown-entire;
			rockchip,enable-pagefault-fake-mode;
			status = "disabled";
		};

		sai4: sai@27610000 {
			compatible = "rockchip,rk3572-sai", "rockchip,sai-v1";
			reg = <0x0 0x27610000 0x0 0x1000>;
			interrupts = <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru MCLK_SAI4>, <&cru HCLK_SAI4>;
			clock-names = "mclk", "hclk";
			dmas = <&dmac0 8>, <&dmac0 9>;
			dma-names = "tx", "rx";
			power-domains = <&power RK3572_PD_VO>;
			resets = <&cru SRST_MRESETN_SAI4>, <&cru SRST_HRESETN_SAI4>;
			reset-names = "m", "h";
			pinctrl-names = "default";
			pinctrl-0 = <&sai4m0_lrck_pins
				     &sai4m0_sclk_pins
