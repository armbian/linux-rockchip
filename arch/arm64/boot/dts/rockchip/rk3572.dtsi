			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c170000 0x0 0x100>;
			interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART5>, <&cru PCLK_UART5>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 31>, <&dmac0 32>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart5m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart6: serial@2c180000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c180000 0x0 0x100>;
			interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART6>, <&cru PCLK_UART6>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 33>, <&dmac0 34>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart6m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart7: serial@2c190000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c190000 0x0 0x100>;
			interrupts = <GIC_SPI 131 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART7>, <&cru PCLK_UART7>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 35>, <&dmac0 36>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart7m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart8: serial@2c1a0000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c1a0000 0x0 0x100>;
			interrupts = <GIC_SPI 132 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART8>, <&cru PCLK_UART8>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 37>, <&dmac0 38>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart8m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart9: serial@2c1b0000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c1b0000 0x0 0x100>;
			interrupts = <GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART9>, <&cru PCLK_UART9>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 39>, <&dmac0 40>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart9m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart10: serial@2c1c0000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c1c0000 0x0 0x100>;
			interrupts = <GIC_SPI 134 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART10>, <&cru PCLK_UART10>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 41>, <&dmac0 42>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart10m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart11: serial@2c1d0000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c1d0000 0x0 0x100>;
			interrupts = <GIC_SPI 135 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART11>, <&cru PCLK_UART11>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 43>, <&dmac0 44>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart11m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		saradc: adc@2c1e0000 {
			compatible = "rockchip,rk3572-saradc", "rockchip,rk3588-saradc";
			reg = <0x0 0x2c1e0000 0x0 0x1000>;
			interrupts = <GIC_SPI 157 IRQ_TYPE_LEVEL_HIGH>;
			#io-channel-cells = <1>;
			clocks = <&cru CLK_SARADC>, <&cru PCLK_SARADC>;
			clock-names = "saradc", "apb_pclk";
			resets = <&cru SRST_PRESETN_SARADC>, <&cru SRST_RESETN_SARADC>;
			reset-names = "saradc-apb", "saradc";
			status = "disabled";
		};

		tsadc: tsadc@2c1f0000 {
			compatible = "rockchip,rk3572-tsadc";
			reg = <0x0 0x2c1f0000 0x0 0x1000>;
			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru CLK_TSADC>, <&cru PCLK_TSADC>;
			clock-names = "tsadc", "apb_pclk";
			assigned-clocks = <&cru CLK_TSADC>;
			assigned-clock-rates = <2000000>;
			resets = <&cru SRST_RESETN_TSADC>, <&cru SRST_PRESETN_TSADC>;
			reset-names = "tsadc", "tsadc-apb";
			#thermal-sensor-cells = <1>;
			rockchip,hw-tshut-temp = <120000>;
			rockchip,hw-tshut-mode = <0>; /* tshut mode 0:CRU 1:GPIO */
			rockchip,hw-tshut-polarity = <0>; /* tshut polarity 0:LOW 1:HIGH */
			status = "disabled";
		};

		hdptxphy: phy@2c310000 {
			compatible = "rockchip,rk3572-hdptx-phy", "rockchip,rk3588-hdptx-phy";
			reg = <0x0 0x2c310000 0x0 0x10000>;
			clocks = <&xin24m>, <&cru PCLK_HDPTXPHY>;
			clock-names = "ref", "apb";
			resets = <&cru SRST_PRESETN_HDPTXPHY>, <&cru SRST_RESETN_HDPTX_INIT>,
				 <&cru SRST_RESETN_HDPTX_CMN>, <&cru SRST_RESETN_HDPTX_LANE>;
			reset-names = "apb", "init", "cmn", "lane";
			rockchip,grf = <&hdptxphy_grf>;
			#phy-cells = <0>;
			status = "disabled";
		};

		gpu: gpu@2d000000 {
			compatible = "arm,mali-valhall";
			reg = <0x0 0x2d000000 0x0 0x200000>;
			interrupts = <GIC_SPI 334 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 332 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 333 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "GPU", "MMU", "JOB";

			clocks = <&cru CLK_GPU_COREGROUP>, <&cru CLK_GPU_STACKS>,
				 <&cru CLK_GPU>;
			clock-names = "clk_gpu_coregroup", "clk_gpu_stacks",
				      "clk_gpu";
			power-domains = <&power RK3572_PD_GPU>;

			upthreshold = <30>;
			downdifferential = <10>;

			status = "disabled";
		};
	};
};

#include "rk3572-pinctrl.dtsi"
