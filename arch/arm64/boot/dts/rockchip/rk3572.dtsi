#include <dt-bindings/clock/rockchip,rk3572-cru.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/power/rockchip,rk3572-power-controller.h>
#include <dt-bindings/reset/rockchip,rk3572-cru.h>
#include <dt-bindings/soc/rockchip,boot-mode.h>

/ {
	compatible = "rockchip,rk3572";

	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		gpio0 = &gpio0;
		gpio1 = &gpio1;
		gpio2 = &gpio2;
		gpio3 = &gpio3;
		gpio4 = &gpio4;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		i2c9 = &i2c9;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		serial9 = &uart9;
		serial10 = &uart10;
		serial11 = &uart11;
		spi0 = &spi0;
		spi1 = &spi1;
	};

	clocks {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		clk_rcosc: clk_rcosc {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
			clock-output-names = "clk_rcosc";
		};

		spll: spll {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <702000000>;
			clock-output-names = "spll";
		};

		xin24m: xin24m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
			clock-output-names = "xin24m";
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu_l0>;
				};
				core1 {
					cpu = <&cpu_l1>;
				};
				core2 {
					cpu = <&cpu_l2>;
				};
				core3 {
					cpu = <&cpu_l3>;
				};
			};
			cluster1 {
				core0 {
					cpu = <&cpu_l4>;
				};
				core1 {
					cpu = <&cpu_l5>;
				};
			};
			cluster2 {
				core0 {
					cpu = <&cpu_b0>;
				};
				core1 {
					cpu = <&cpu_b1>;
				};
			};
		};

		cpu_l0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0>;
			enable-method = "psci";
		};

		cpu_l1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x1>;
			enable-method = "psci";
		};

		cpu_l2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x2>;
			enable-method = "psci";
		};

		cpu_l3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x3>;
			enable-method = "psci";
		};

		cpu_l4: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			enable-method = "psci";
		};

		cpu_l5: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			enable-method = "psci";
		};

		cpu_b0: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x200>;
			enable-method = "psci";
		};

		cpu_b1: cpu@201 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x201>;
			enable-method = "psci";
		};
	};

	display_subsystem: display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <&vop_out>;

		route {
			route_rgb: route-rgb {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp1_out_rgb>;
			};

			route_dsi: route-dsi {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp1_out_dsi>;
			};

			route_edp: route-edp {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp1_out_edp>;
			};

			route_hdmi: route-hdmi {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&vp0_out_hdmi>;
			};
		};
	};

	mpp_srv: mpp-srv {
		compatible = "rockchip,mpp-service";
		rockchip,taskqueue-count = <4>;
		rockchip,resetgroup-count = <4>;
		status = "disabled";
	};

	pinctrl: pinctrl {
		compatible = "rockchip,rk3572-pinctrl";
		rockchip,grf = <&ioc_grf>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gpio0: gpio@26300000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x26300000 0x0 0x200>;
			interrupts = <GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO0>, <&cru DBCLK_GPIO0>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 0 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio1: gpio@2b200000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x2b200000 0x0 0x200>;
			interrupts = <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO1>, <&cru DBCLK_GPIO1>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 32 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio2: gpio@2b300000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x2b300000 0x0 0x200>;
			interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 114 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO2>, <&cru DBCLK_GPIO2>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 64 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio3: gpio@2b400000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x2b400000 0x0 0x200>;
			interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO3>, <&cru DBCLK_GPIO3>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 96 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		gpio4: gpio@2b500000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x0 0x2b500000 0x0 0x200>;
			interrupts = <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 121 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 122 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_GPIO4>, <&cru DBCLK_GPIO4>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 128 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};

	pmu_a53: pmu-cluster0 {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu_l0>, <&cpu_l1>, <&cpu_l2>, <&cpu_l3>,
				     <&cpu_l4>, <&cpu_l5>;
	};

	pmu_a73: pmu-cluster2 {
		compatible = "arm,cortex-a73-pmu";
		interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu_b0>, <&cpu_b1>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	rkisp_vir0: rkisp-vir0 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	rkisp_vir1: rkisp-vir1 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	rkisp_vir2: rkisp-vir2 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	rkisp_vir3: rkisp-vir3 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	rkisp_vir4: rkisp-vir4 {
		compatible = "rockchip,rkisp-vir";
		rockchip,hw = <&rkisp>;
		status = "disabled";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		usb_drd0_dwc3: usb@24000000 {
			compatible = "rockchip,rk3572-dwc3", "rockchip,rk3576-dwc3", "snps,dwc3";
			reg = <0x0 0x24000000 0x0 0x400000>;
			clocks = <&cru CLK_REF_USB3OTG0>,
				 <&cru CLK_SUSPEND_USB3OTG0>,
				 <&cru ACLK_USB3OTG0>;
			clock-names = "ref", "suspend", "bus_clk";
			interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&power RK3572_PD_PHP>;
			resets = <&cru SRST_ARESETN_USB3OTG0>;
			reset-names = "usb3-otg";
			dr_mode = "otg";
			phys = <&u2phy0_otg>;
			phy-names = "usb2-phy";
			phy_type = "utmi_wide";
			snps,dis_enblslpm_quirk;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			snps,parkmode-disable-hs-quirk;
			snps,parkmode-disable-ss-quirk;
			status = "disabled";
		};

		usb_drd1_dwc3: usb@24400000 {
			compatible = "rockchip,rk3572-dwc3", "rockchip,rk3576-dwc3", "snps,dwc3";
			reg = <0x0 0x24400000 0x0 0x400000>;
			clocks = <&cru CLK_REF_USB3OTG1>,
				 <&cru CLK_SUSPEND_USB3OTG1>,
				 <&cru ACLK_USB3OTG1>;
			clock-names = "ref", "suspend", "bus_clk";
			interrupts = <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&power RK3572_PD_PHP>;
			resets = <&cru SRST_ARESETN_USB3OTG1>;
			reset-names = "usb3-otg";
			dr_mode = "otg";
			phys = <&u2phy1_otg>;
			phy-names = "usb2-phy";
			phy_type = "utmi_wide";
			snps,dis_enblslpm_quirk;
			snps,dis-u1-entry-quirk;
			snps,dis-u2-entry-quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			snps,parkmode-disable-hs-quirk;
			snps,parkmode-disable-ss-quirk;
			status = "disabled";
		};

		sys_grf: syscon@26010000 {
			compatible = "rockchip,rk3572-sys-grf", "syscon";
			reg = <0x0 0x26010000 0x0 0x2000>;
		};

		vo_grf: syscon@26022000 {
			compatible = "rockchip,rk3572-vo-grf", "syscon";
			reg = <0x0 0x26022000 0x0 0x2000>;
			clocks = <&cru PCLK_VO_ROOT>;
		};

		php_grf: syscon@26026000 {
			compatible = "rockchip,rk3572-php-grf", "syscon";
			reg = <0x0 0x26026000 0x0 0x1000>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;
		};

		audio_grf: syscon@2602c000 {
			compatible = "rockchip,rk3572-audio-grf", "syscon";
			reg = <0x0 0x2602c000 0x0 0x1000>;
			clocks = <&cru PCLK_AUDIO_ROOT>;
		};

		pmu1_grf: syscon@26042000 {
			compatible = "rockchip,rk3572-pmu1-grf", "syscon", "simple-mfd";
			reg = <0x0 0x26042000 0x0 0x2000>;

			reboot_mode: reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x1000>;
				mode-bootloader = <BOOT_BL_DOWNLOAD>;
				mode-charge = <BOOT_CHARGING>;
				mode-fastboot = <BOOT_FASTBOOT>;
				mode-loader = <BOOT_BL_DOWNLOAD>;
				mode-normal = <BOOT_NORMAL>;
				mode-recovery = <BOOT_RECOVERY>;
				mode-ums = <BOOT_UMS>;
				mode-panic = <BOOT_PANIC>;
				mode-watchdog = <BOOT_WATCHDOG>;
				mode-quiescent = <BOOT_QUIESCENT>;
				/* add a mode to capture the ramdump through usb */
				mode-winusb = <BOOT_WINUSB>;
			};
		};

		usb2phy_grf: syscon@26054000 {
			compatible = "rockchip,rk3572-usb2phy-grf", "syscon", "simple-mfd";
			reg = <0x0 0x26054000 0x0 0x4000>;
			#address-cells = <1>;
			#size-cells = <1>;
			clocks = <&cru PCLK_PHPSUBSYS_ROOT>;

			u2phy0: usb2-phy@0 {
				compatible = "rockchip,rk3572-usb2phy";
				reg = <0x0 0x10>;
				resets = <&cru SRST_RESETN_OTGPHY_0>, <&cru SRST_PRESETN_USBPHY_GRF_0>;
				reset-names = "phy", "apb";
				clocks = <&xin24m>;
				clock-names = "phyclk";
				clock-output-names = "usb480m_phy0";
				#clock-cells = <0>;
				rockchip,usbctrl-grf = <&php_grf>;
				status = "disabled";

				u2phy0_otg: otg-port {
					#phy-cells = <0>;
					interrupts = <GIC_SPI 288 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 290 IRQ_TYPE_LEVEL_HIGH>;
					interrupt-names = "otg-bvalid", "otg-id", "linestate";
					status = "disabled";
				};
			};

			u2phy1: usb2-phy@2000 {
				compatible = "rockchip,rk3572-usb2phy";
				reg = <0x2000 0x10>;
				resets = <&cru SRST_RESETN_OTGPHY_1>, <&cru SRST_PRESETN_USBPHY_GRF_1>;
				reset-names = "phy", "apb";
				clocks = <&xin24m>;
				clock-names = "phyclk";
				clock-output-names = "usb480m_phy1";
				#clock-cells = <0>;
				rockchip,usbctrl-grf = <&php_grf>;
				status = "disabled";

				u2phy1_otg: otg-port {
					#phy-cells = <0>;
					interrupts = <GIC_SPI 293 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH>,
						     <GIC_SPI 295 IRQ_TYPE_LEVEL_HIGH>;
					interrupt-names = "otg-bvalid", "otg-id", "linestate";
					status = "disabled";
				};
			};
		};

		hdptxphy_grf: syscon@26060000 {
			compatible = "rockchip,rk3572-hdptxphy-grf", "syscon";
			reg = <0x0 0x26060000 0x0 0x2000>;
		};

		ioc_grf: syscon@26072000 {
			compatible = "rockchip,rk3572-ioc-grf", "syscon", "simple-mfd";
			reg = <0x0 0x26072000 0x0 0x16000>;

			rgb: rgb {
				compatible = "rockchip,rk3572-rgb";
				pinctrl-names = "default";
				status = "disabled";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;

						rgb_in_vp0: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&vp0_out_rgb>;
							status = "disabled";
						};

						rgb_in_vp1: endpoint@1 {
							reg = <1>;
							remote-endpoint = <&vp1_out_rgb>;
							status = "disabled";
						};

						rgb_in_vopl: endpoint@2 {
							reg = <2>;
							remote-endpoint = <&vopl_out_rgb>;
							status = "disabled";
						};
					};
				};
			};
		};

		cru: clock-controller@26090000 {
			compatible = "rockchip,rk3572-cru";
			reg = <0x0 0x26090000 0x0 0x60000>;
			#clock-cells = <1>;
			#reset-cells = <1>;

			assigned-clocks =
				<&cru CLK_AUDIO_FRAC_1_SRC>, <&cru PLL_CPLL>,
				<&cru PLL_AUPLL>, <&cru CLK_UART_FRAC_0>,
				<&cru CLK_UART_FRAC_1>, <&cru CLK_UART_FRAC_2>,
				<&cru CLK_AUDIO_FRAC_0>, <&cru CLK_AUDIO_FRAC_1>,
				<&cru CLK_AUDIO_INT_0>, <&cru CLK_AUDIO_INT_1>,
				<&cru CLK_GPU>;
			assigned-clock-parents = <&cru PLL_AUPLL>;
			assigned-clock-rates =
				<0>, <1000000000>,
				<786432000>, <18432000>,
				<96000000>, <128000000>,
				<45158400>, <49152000>,
				<49152000>, <24576000>,
				<200000000>;
		};

		pwm0_2ch_0: pwm@26200000 {
			compatible = "rockchip,rk3572-pwm", "rockchip,rk3538-pwm";
			reg = <0x0 0x26200000 0x0 0x1000>;
			interrupts = <GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm0m0_ch0_pins>;
			clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>,
				 <&cru CLK_PWM0_OSC>, <&cru CLK_PWM0_RC>;
			clock-names = "pwm", "pclk",
				      "osc", "rc";
			status = "disabled";
		};

		pwm0_2ch_1: pwm@26210000 {
			compatible = "rockchip,rk3572-pwm", "rockchip,rk3538-pwm";
			reg = <0x0 0x26210000 0x0 0x1000>;
			interrupts = <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH>;
			#pwm-cells = <3>;
			pinctrl-names = "active";
			pinctrl-0 = <&pwm0m0_ch1_pins>;
			clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>,
				 <&cru CLK_PWM0_OSC>, <&cru CLK_PWM0_RC>;
			clock-names = "pwm", "pclk",
				      "osc", "rc";
			status = "disabled";
		};

		uart1: serial@26500000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x26500000 0x0 0x100>;
			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART1>, <&cru PCLK_UART1>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 23>, <&dmac0 24>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart1m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		i2c0: i2c@26520000 {
			compatible = "rockchip,rk3572-i2c", "rockchip,rk3399-i2c";
			reg = <0x0 0x26520000 0x0 0x1000>;
			clocks = <&cru CLK_I2C0>, <&cru PCLK_I2C0>;
			clock-names = "i2c", "pclk";
			interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0m0_xfer_pins>;
			resets = <&cru SRST_RESETN_I2C0>, <&cru SRST_PRESETN_I2C0>;
			reset-names = "i2c", "apb";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		pmu: power-management@26550000 {
			compatible = "rockchip,rk3572-pmu", "syscon", "simple-mfd";
			reg = <0x0 0x26550000 0x0 0x1000>;
			rockchip,grf = <&sys_grf>;

			power: power-controller {
				compatible = "rockchip,rk3572-power-controller";
				#power-domain-cells = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "okay";

				/* These power domains are grouped by VD_NPU */
				power-domain@RK3572_PD_NPU {
					reg = <RK3572_PD_NPU>;
				};
				/* These power domains are grouped by VD_GPU */
				power-domain@RK3572_PD_GPU {
					reg = <RK3572_PD_GPU>;
				};
				/* These power domains are grouped by VD_LOGIC */
				power-domain@RK3572_PD_NVM1 {
					reg = <RK3572_PD_NVM1>;
				};
				power-domain@RK3572_PD_DSMC {
					reg = <RK3572_PD_DSMC>;
				};
				power-domain@RK3572_PD_PHP {
					reg = <RK3572_PD_PHP>;
				};
				power-domain@RK3572_PD_AUDIO {
					reg = <RK3572_PD_AUDIO>;
				};
				power-domain@RK3572_PD_IMG {
					reg = <RK3572_PD_IMG>;
				};
				power-domain@RK3572_PD_VDEC {
					reg = <RK3572_PD_VDEC>;
				};
				power-domain@RK3572_PD_VI {
					reg = <RK3572_PD_VI>;
					#address-cells = <1>;
					#size-cells = <0>;

					power-domain@RK3572_PD_VENC {
						reg = <RK3572_PD_VENC>;
					};
				};
				power-domain@RK3572_PD_VOP {
					reg = <RK3572_PD_VOP>;
					#address-cells = <1>;
					#size-cells = <0>;

					power-domain@RK3572_PD_VOP_PRE {
						reg = <RK3572_PD_VOP_PRE>;
					};
					power-domain@RK3572_PD_VO {
						reg = <RK3572_PD_VO>;
					};
					power-domain@RK3572_PD_NVM0 {
						reg = <RK3572_PD_NVM0>;
					};
				};
			};
		};

		pdm0: pdm@26600000 {
			compatible = "rockchip,rk3572-pdm", "rockchip,rk3576-pdm";
			reg = <0x0 0x26600000 0x0 0x1000>;
			interrupts = <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru MCLK_PDM0>, <&cru HCLK_PDM0>, <&cru CLK_PDM0_OUT>;
			clock-names = "pdm_clk", "pdm_hclk", "pdm_clk_out";
			dmas = <&dmac0 16>;
			dma-names = "rx";
			rockchip,pdm-data-shift = <5 5 5 5 5 5 5 5>;
			pinctrl-names = "default", "idle", "clk";
			pinctrl-0 = <&pdmm0_sdi0_pins
				     &pdmm0_sdi1_pins
				     &pdmm0_sdi2_pins
				     &pdmm0_sdi3_pins>;
			pinctrl-1 = <&pdmm0_clk0_idle
				     &pdmm0_clk1_idle>;
			pinctrl-2 = <&pdmm0_clk0_pins
				     &pdmm0_clk1_pins>;
			#sound-dai-cells = <0>;
			sound-name-prefix = "PDM0";
			status = "disabled";
		};

		cci_hwlock0: hwspinlock@26900000 {
			compatible = "rockchip,hwspinlock";
			reg = <0x0 0x26900000 0x0 0x20>;
			#hwlock-cells = <1>;
			rockchip,hwlock-num-locks = <8>;
			rockchip,hwlock-max-user = <0x3f>;
			status = "disabled";
		};

		cci_hwlock1: hwspinlock@26910000 {
			compatible = "rockchip,hwspinlock";
			reg = <0x0 0x26910000 0x0 0x20>;
			#hwlock-cells = <1>;
			rockchip,hwlock-num-locks = <8>;
			rockchip,hwlock-max-user = <0x3f>;
			status = "disabled";
		};

		cci_hwlock2: hwspinlock@26920000 {
			compatible = "rockchip,hwspinlock";
			reg = <0x0 0x26920000 0x0 0x20>;
			#hwlock-cells = <1>;
			rockchip,hwlock-num-locks = <8>;
			rockchip,hwlock-max-user = <0x3f>;
			status = "disabled";
		};

		cci_hwlock3: hwspinlock@26930000 {
			compatible = "rockchip,hwspinlock";
			reg = <0x0 0x26930000 0x0 0x20>;
			#hwlock-cells = <1>;
			rockchip,hwlock-num-locks = <8>;
			rockchip,hwlock-max-user = <0x3f>;
			status = "disabled";
		};

		vopl: vop@27100000 {
			compatible = "rockchip,rk3572-vop-lit";
			reg = <0x0 0x27100000 0x0 0x200>;
			reg-names = "regs";
			interrupts = <GIC_SPI 193 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_EBC>, <&cru DCLK_EBC>, <&cru HCLK_EBC>;
			clock-names = "aclk_vop", "dclk_vop", "hclk_vop";
			power-domains = <&power RK3572_PD_IMG>, <&power RK3572_PD_VO>;
			power-domain-names = "pd0", "pd1";
			rockchip,grf = <&ioc_grf>;
			rockchip,vo0-grf = <&vo_grf>;
			status = "disabled";

			vopl_out: port {
				#address-cells = <1>;
				#size-cells = <0>;

				vopl_out_rgb: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&rgb_in_vopl>;
				};

				vopl_out_dsi: endpoint@1 {
					reg = <1>;
					//remote-endpoint = <&dsi_in_vopl>;
				};

				vopl_out_edp: endpoint@2 {
					reg = <2>;
					remote-endpoint = <&edp_in_vopl>;
				};

				vopl_out_hdmi: endpoint@3 {
					reg = <3>;
					//remote-endpoint = <&hdmi_in_vopl>;
				};
			};
		};

		rga2_core0: rga@27120000 {
			compatible = "rockchip,rga2";
			reg = <0x0 0x27120000 0x0 0x1000>;
			interrupts = <GIC_SPI 194 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "rga2_core0_irq";
			clocks = <&cru ACLK_RGA2E_0>, <&cru HCLK_RGA2E_0>, <&cru CLK_CORE_RGA2E_0>;
			clock-names = "aclk_rga", "hclk_rga", "clk_rga";
			power-domains = <&power RK3572_PD_IMG>;
			iommus = <&rga2_core0_mmu>;
			status = "disabled";
		};

		rga2_core0_mmu: iommu@27120f00 {
			compatible = "rockchip,iommu-v2";
			reg = <0x0 0x27120f00 0x0 0x100>;
			interrupts = <GIC_SPI 194 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "rga2_0_mmu";
			clocks = <&cru ACLK_RGA2E_0>, <&cru HCLK_RGA2E_0>;
			clock-names = "aclk", "iface";
			power-domains = <&power RK3572_PD_IMG>;
			#iommu-cells = <0>;
			status = "disabled";
		};

		iep: iep@27130000 {
			compatible = "rockchip,iep-v2";
			reg = <0x0 0x27130000 0x0 0x700>;
			interrupts = <GIC_SPI 198 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "irq_vdpp";
			clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>, <&cru CLK_CORE_VDPP>;
			clock-names = "aclk", "hclk", "sclk";
			rockchip,normal-rates = <600000000>, <0>, <600000000>;
			assigned-clocks = <&cru ACLK_VDPP>, <&cru CLK_CORE_VDPP>;
			assigned-clock-rates = <600000000>, <600000000>;
			resets = <&cru SRST_ARESETN_VDPP>, <&cru SRST_HRESETN_VDPP>,
				 <&cru SRST_RESETN_CORE_VDPP>;
			reset-names = "shared_rst_a", "shared_rst_h", "shared_rst_s";
			rockchip,skip-pmu-idle-request;
			rockchip,srv = <&mpp_srv>;
			rockchip,taskqueue-node = <1>;
			rockchip,resetgroup-node = <1>;
			iommus = <&iep_mmu>;
			power-domains = <&power RK3572_PD_IMG>;
			status = "disabled";
		};

		iep_mmu: iommu@27130800 {
			compatible = "rockchip,iommu-v2";
			reg = <0x0 0x27130800 0x0 0x100>;
			interrupts = <GIC_SPI 198 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "iep_mmu";
			clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			rockchip,shootdown-entire;
			power-domains = <&power RK3572_PD_IMG>;
			status = "disabled";
		};

		vdpp: vdpp@27131000 {
			compatible = "rockchip,vdpp-rk3572";
			reg = <0x0 0x27131000 0x0 0x500>, <0x0 0x27132800 0x0 0x50>;
			reg-names = "vdpp_regs", "zme_regs";
			interrupts = <GIC_SPI 198 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "irq_vdpp";
			clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>, <&cru CLK_CORE_VDPP>;
			clock-names = "aclk", "hclk", "sclk";
			rockchip,normal-rates = <600000000>, <0>, <600000000>;
			assigned-clocks = <&cru ACLK_VDPP>, <&cru CLK_CORE_VDPP>;
			assigned-clock-rates = <600000000>, <600000000>;
			resets = <&cru SRST_ARESETN_VDPP>, <&cru SRST_HRESETN_VDPP>,
				 <&cru SRST_RESETN_CORE_VDPP>;
			reset-names = "shared_rst_a", "shared_rst_h", "shared_rst_s";
			rockchip,skip-pmu-idle-request;
			rockchip,srv = <&mpp_srv>;
			rockchip,taskqueue-node = <1>;
			rockchip,resetgroup-node = <1>;
			rockchip,disable-auto-freq;
			iommus = <&iep_mmu>;
			power-domains = <&power RK3572_PD_IMG>;
			status = "disabled";
		};

		rkisp: isp@27420000 {
			compatible = "rockchip,rk3572-rkisp";
			reg = <0x0 0x27420000 0x0 0x7f00>;
			interrupts = <GIC_SPI 211 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 212 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 213 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "mipi_irq", "mi_irq", "isp_irq";
			clocks = <&cru ACLK_ISP>, <&cru HCLK_ISP>,
				 <&cru CLK_ISP_CORE>, <&cru CLK_ISP_CORE_MARVIN>,
				 <&cru CLK_ISP_CORE_VICAP>;
			clock-names = "aclk_isp", "hclk_isp",
				      "clk_isp_core", "clk_isp_core_marvin",
				      "clk_isp_core_vicap";
			power-domains = <&power RK3572_PD_VI>;
			iommus = <&rkisp_mmu>;
			status = "disabled";
		};

		rkisp_mmu: iommu@27427f00 {
			compatible = "rockchip,iommu-v2";
			reg = <0x0 0x27427f00 0x0 0x100>;
			interrupts = <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "isp_mmu";
			clocks = <&cru ACLK_ISP>, <&cru HCLK_ISP>;
			clock-names = "aclk", "iface";
			power-domains = <&power RK3572_PD_VI>;
			#iommu-cells = <0>;
			rockchip,disable-mmu-reset;
			status = "disabled";
		};

		vop: vop@27500000 {
			compatible = "rockchip,rk3572-vop";
			reg = <0x0 0x27500000 0x0 0x3c00>,
			      <0x0 0x27505000 0x0 0x1000>,
			      <0x0 0x27506400 0x0 0x800>,
			      <0x0 0x27506c00 0x0 0x300>;
			reg-names = "regs",
				    "gamma_lut",
				    "acm_regs",
				    "sharp_regs";
			interrupts = <GIC_SPI 329 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 328 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 327 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "vop-sys",
					  "vop-vp0",
					  "vop-vp1";
			clocks = <&cru ACLK_VOP>,
				 <&cru HCLK_VOP>,
				 <&cru DCLK_VP0>,
				 <&cru DCLK_VP1>,
				 <&cru DCLK_VP0_SRC>,
				 <&cru DCLK_VP1_SRC>;
			clock-names = "aclk_vop",
				      "hclk_vop",
				      "dclk_vp0",
				      "dclk_vp1",
				      "dclk_src_vp0",
				      "dclk_src_vp1";
			resets = <&cru SRST_DRESETN_VP0>,
				 <&cru SRST_DRESETN_VP1>;
			reset-names = "dclk_vp0",
				      "dclk_vp1";
			rockchip,aclk-normal-mode-rates = <500000000>;
			rockchip,aclk-reset-mode-rates = <594000000>;
			rockchip,aclk-advanced-mode-rates = <702000000>;
			iommus = <&vop_mmu>;
			rockchip,ioc-grf = <&ioc_grf>;
			status = "disabled";

			vop_out: ports {
				#address-cells = <1>;
				#size-cells = <0>;

				vp0: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;

					vp0_out_rgb: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&rgb_in_vp0>;
					};

					vp0_out_dsi: endpoint@1 {
						reg = <1>;
					};

					vp0_out_edp: endpoint@2 {
						reg = <2>;
						remote-endpoint = <&edp_in_vp0>;
					};

					vp0_out_hdmi: endpoint@3 {
						reg = <3>;
					};
				};

				vp1: port@1 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <1>;

					vp1_out_rgb: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&rgb_in_vp1>;
					};

					vp1_out_dsi: endpoint@1 {
						reg = <1>;
					};

					vp1_out_edp: endpoint@2 {
						reg = <2>;
						remote-endpoint = <&edp_in_vp1>;
					};

					vp1_out_hdmi: endpoint@3 {
						reg = <3>;
					};
				};
			};
		};

		vop_mmu: iommu@27507e00 {
			compatible = "rockchip,iommu-v2";
			reg = <0x0 0x27507e00 0x0 0x100>, <0x0 0x27507f00 0x0 0x100>;
			interrupts = <GIC_SPI 329 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "vop_mmu";
			clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			rockchip,disable-device-link-resume;
			rockchip,shootdown-entire;
			rockchip,enable-pagefault-fake-mode;
			status = "disabled";
		};

		sai4: sai@27610000 {
			compatible = "rockchip,rk3572-sai", "rockchip,sai-v1";
			reg = <0x0 0x27610000 0x0 0x1000>;
			interrupts = <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru MCLK_SAI4>, <&cru HCLK_SAI4>;
			clock-names = "mclk", "hclk";
			dmas = <&dmac0 8>, <&dmac0 9>;
			dma-names = "tx", "rx";
			power-domains = <&power RK3572_PD_VO>;
			resets = <&cru SRST_MRESETN_SAI4>, <&cru SRST_HRESETN_SAI4>;
			reset-names = "m", "h";
			pinctrl-names = "default";
			pinctrl-0 = <&sai4m0_lrck_pins
				     &sai4m0_sclk_pins
				     &sai4m0_sdi0_pins
				     &sai4m0_sdi1_pins
				     &sai4m0_sdi2_pins
				     &sai4m0_sdi3_pins
				     &sai4m0_sdo0_pins>;
			#sound-dai-cells = <0>;
			sound-name-prefix = "SAI4";
			status = "disabled";
		};

		sai5: sai@27620000 {
			compatible = "rockchip,rk3572-sai", "rockchip,sai-v1";
			reg = <0x0 0x27620000 0x0 0x1000>;
			interrupts = <GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru MCLK_SAI5>, <&cru HCLK_SAI5>;
			clock-names = "mclk", "hclk";
			dmas = <&dmac0 10>;
			dma-names = "rx";
			power-domains = <&power RK3572_PD_VO>;
			resets = <&cru SRST_MRESETN_SAI5>, <&cru SRST_HRESETN_SAI5>;
			reset-names = "m", "h";
			#sound-dai-cells = <0>;
			sound-name-prefix = "SAI5";
			status = "disabled";
		};

		spdif_tx2: spdif-tx@27630000 {
			compatible = "rockchip,rk3572-spdif", "rockchip,rk3538-spdif";
			reg = <0x0 0x27630000 0x0 0x1000>;
			interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru MCLK_SPDIF_TX2>, <&cru HCLK_SPDIF_TX2>;
			clock-names = "mclk", "hclk";
			dmas = <&dmac0 13>;
			dma-names = "tx";
			power-domains = <&power RK3572_PD_VO>;
			#sound-dai-cells = <0>;
			status = "disabled";
		};

		spdif_rx1: spdif-rx@27640000 {
			compatible = "rockchip,rk3572-spdifrx", "rockchip,rk3308-spdifrx";
			reg = <0x0 0x27640000 0x0 0x1000>;
			interrupts = <GIC_SPI 185 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru MCLK_SPDIF_RX1>, <&cru HCLK_SPDIF_RX1>;
			clock-names = "mclk", "hclk";
			dmas = <&dmac0 15>;
			dma-names = "rx";
			power-domains = <&power RK3572_PD_VO>;
			resets = <&cru SRST_MRESETN_SPDIF_RX1>;
			reset-names = "spdifrx-m";
			#sound-dai-cells = <0>;
			status = "disabled";
		};

		edp: edp@276b0000 {
			compatible = "rockchip,rk3572-edp";
			reg = <0x0 0x276b0000 0x0 0x10000>;
			interrupts = <GIC_SPI 218 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru CLK_EDP0_24M>, <&cru PCLK_EDP0>,
				 <&cru CLK_EDP0_200M>, <&cru HCLK_VO_ROOT>;
			clock-names = "dp", "pclk", "spdif", "hclk";
			resets = <&cru SRST_RESETN_EDP0_24M>, <&cru SRST_PRESETN_EDP0>;
			reset-names = "dp", "apb";
			phys = <&hdptxphy>;
			phy-names = "dp";
			power-domains = <&power RK3572_PD_VO>;
			rockchip,grf = <&vo_grf>;
			#sound-dai-cells = <1>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					edp_in_vp0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&vp0_out_edp>;
						status = "disabled";
					};

					edp_in_vp1: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&vp1_out_edp>;
						status = "disabled";
					};

					edp_in_vopl: endpoint@2 {
						reg = <2>;
						remote-endpoint = <&vopl_out_edp>;
						status = "disabled";
					};
				};
			};
		};

		sdmmc1: mmc@2a000000 {
			compatible = "rockchip,rk3572-dw-mshc", "rockchip,rk3576-dw-mshc";
			reg = <0x0 0x2a000000 0x0 0x4000>;
			interrupts = <GIC_SPI 245 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru HCLK_SDMMC1>, <&cru CCLK_SRC_SDMMC1>;
			clock-names = "biu", "ciu";
			fifo-depth = <0x100>;
			max-frequency = <200000000>;
			pinctrl-names = "default";
			pinctrl-0 = <&sdmmc1_bus4_pins &sdmmc1_clk_pins &sdmmc1_cmd_pins
				     &sdmmc1_pwren_pins &sdmmc1m0_det_pins>;
			power-domains = <&power RK3572_PD_NVM0>;
			resets = <&cru SRST_HRESETN_SDMMC1>;
			reset-names = "reset";
			status = "disabled";
		};

		sdhci: mmc@2a010000 {
			compatible = "rockchip,rk3572-dwcmshc", "rockchip,rk3576-dwcmshc";
			reg = <0x0 0x2a010000 0x0 0x10000>;
			interrupts = <GIC_SPI 243 IRQ_TYPE_LEVEL_HIGH>;
			assigned-clocks = <&cru BCLK_EMMC>, <&cru TCLK_EMMC>, <&cru CCLK_SRC_EMMC>;
			assigned-clock-rates = <200000000>, <24000000>, <200000000>;
			clocks = <&cru CCLK_SRC_EMMC>, <&cru HCLK_EMMC>,
				 <&cru ACLK_EMMC>, <&cru BCLK_EMMC>,
				 <&cru TCLK_EMMC>;
			clock-names = "core", "bus", "axi", "block", "timer";
			max-frequency = <200000000>;
			power-domains = <&power RK3572_PD_NVM0>;
			resets = <&cru SRST_CRESETN_EMMC>, <&cru SRST_HRESETN_EMMC>,
				 <&cru SRST_ARESETN_EMMC>, <&cru SRST_BRESETN_EMMC>,
				 <&cru SRST_TRESETN_EMMC>;
			reset-names = "core", "bus", "axi", "block", "timer";
			supports-cqe;
			status = "disabled";
		};

		sdmmc0: mmc@2a090000 {
			compatible = "rockchip,rk3572-dw-mshc", "rockchip,rk3576-dw-mshc";
			reg = <0x0 0x2a090000 0x0 0x4000>;
			interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru HCLK_SDMMC0>, <&cru CCLK_SRC_SDMMC0>;
			clock-names = "biu", "ciu";
			fifo-depth = <0x100>;
