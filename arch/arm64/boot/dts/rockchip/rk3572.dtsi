		pcie0: pcie@29d00000 {
			compatible = "rockchip,rk3572-pcie", "snps,dw-pcie";
			#address-cells = <3>;
			#size-cells = <2>;
			bus-range = <0x0 0xf>;
			clocks = <&cru ACLK_PCIE0_MSTR>, <&cru ACLK_PCIE0_SLV>,
				 <&cru ACLK_PCIE0_DBI>, <&cru PCLK_PCIE0>,
				 <&cru CLK_PCIE0_AUX>;
			clock-names = "aclk_mstr", "aclk_slv", "aclk_dbi", "pclk", "aux";
			device_type = "pci";
			interrupts = <GIC_SPI 263 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 262 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 261 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 260 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 259 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 258 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 257 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi", "pmc", "sys", "legacy", "msg", "err", "ptm";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie0_intc 0>,
					<0 0 0 2 &pcie0_intc 1>,
					<0 0 0 3 &pcie0_intc 2>,
					<0 0 0 4 &pcie0_intc 3>;
			linux,pci-domain = <0>;
			num-ib-windows = <8>;
			num-viewport = <8>;
			num-ob-windows = <2>;
			max-link-speed = <2>;
			num-lanes = <1>;
			phys = <&combphy0_psu PHY_TYPE_PCIE>;
			phy-names = "pcie-phy";
			power-domains = <&power RK3572_PD_PHP>;
			ranges = <0x00000800 0x0 0x20000000 0x0 0x20000000 0x0 0x00100000
				  0x81000000 0x0 0x20100000 0x0 0x20100000 0x0 0x00100000
				  0x82000000 0x0 0x20200000 0x0 0x20200000 0x0 0x00e00000
				  0xc3000000 0xc 0x00000000 0xc 0x00000000 0x2 0x00000000>;
			reg = <0x0 0x29d00000 0x0 0x00010000>,
			      <0x0 0x22000000 0x0 0x00400000>,
			      <0x0 0x20000000 0x0 0x00100000>;
			reg-names = "pcie-apb", "pcie-dbi", "config";
			resets = <&cru SRST_RESETN_PCIE0_POWER_UP>, <&cru SRST_PRESETN_PCIE0>;
			reset-names = "pipe", "p_pcie0";
			dma-coherent;
			status = "disabled";

			pcie0_intc: legacy-interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 260 IRQ_TYPE_EDGE_RISING>;
			};
		};

		pcie1: pcie@29d10000 {
			compatible = "rockchip,rk3572-pcie", "snps,dw-pcie";
			#address-cells = <3>;
			#size-cells = <2>;
			bus-range = <0x10 0x1f>;
			clocks = <&cru ACLK_PCIE1_MSTR>, <&cru ACLK_PCIE1_SLV>,
				 <&cru ACLK_PCIE1_DBI>, <&cru PCLK_PCIE1>,
				 <&cru CLK_PCIE1_AUX>;
			clock-names = "aclk_mstr", "aclk_slv", "aclk_dbi", "pclk", "aux";
			device_type = "pci";
			interrupts = <GIC_SPI 278 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 277 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 276 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 275 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 274 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 273 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 272 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi", "pmc", "sys", "legacy", "msg", "err", "ptm";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie1_intc 0>,
					<0 0 0 2 &pcie1_intc 1>,
					<0 0 0 3 &pcie1_intc 2>,
					<0 0 0 4 &pcie1_intc 3>;
			linux,pci-domain = <1>;
			num-ib-windows = <8>;
			num-viewport = <8>;
			num-ob-windows = <2>;
			max-link-speed = <2>;
			num-lanes = <1>;
			phys = <&combphy2_ps PHY_TYPE_PCIE>;
			phy-names = "pcie-phy";
			power-domains = <&power RK3572_PD_PHP>;
			ranges = <0x00000800 0x0 0x21000000 0x0 0x21000000 0x0 0x00100000
				  0x81000000 0x0 0x21100000 0x0 0x21100000 0x0 0x00100000
				  0x82000000 0x0 0x21200000 0x0 0x21200000 0x0 0x00e00000
				  0xc3000000 0xe 0x00000000 0xe 0x00000000 0x2 0x00000000>;
			reg = <0x0 0x29d10000 0x0 0x00010000>,
			      <0x0 0x22400000 0x0 0x00400000>,
			      <0x0 0x21000000 0x0 0x00100000>;
			reg-names = "pcie-apb", "pcie-dbi", "config";
			resets = <&cru SRST_RESETN_PCIE1_POWER_UP>, <&cru SRST_PRESETN_PCIE1>;
			reset-names = "pipe", "p_pcie1";
			dma-coherent;
			status = "disabled";

			pcie1_intc: legacy-interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 275 IRQ_TYPE_EDGE_RISING>;
			};
		};

		gmac0: ethernet@29d20000 {
			compatible = "rockchip,rk3572-gmac", "snps,dwmac-4.20a";
			reg = <0x0 0x29d20000 0x0 0x10000>;
			interrupts = <GIC_SPI 228 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 233 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_wake_irq";
			rockchip,grf = <&php_grf>;
			rockchip,php-grf = <&ioc_grf>;
			clocks = <&cru CLK_GMAC0_125M_SRC>, <&cru CLK_GMAC0_RMII_CRU>,
				 <&cru PCLK_GMAC0>, <&cru ACLK_GMAC0>,
				 <&cru CLK_GMAC0_PTP_REF_SRC>;
			clock-names = "stmmaceth", "clk_mac_ref",
				      "pclk_mac", "aclk_mac",
				      "ptp_ref";
			resets = <&cru SRST_ARESETN_GMAC0>;
			reset-names = "stmmaceth";
			power-domains = <&power RK3572_PD_PHP>;

			dma-coherent;
			snps,mixed-burst;
			snps,tso;

			snps,axi-config = <&gmac0_stmmac_axi_setup>;
			snps,mtl-rx-config = <&gmac0_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac0_mtl_tx_setup>;
			status = "disabled";

			mdio0: mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <0x1>;
				#size-cells = <0x0>;
			};

			gmac0_stmmac_axi_setup: stmmac-axi-config {
				snps,wr_osr_lmt = <4>;
				snps,rd_osr_lmt = <8>;
				snps,blen = <0 0 0 0 16 8 4>;
			};

			gmac0_mtl_rx_setup: rx-queues-config {
				snps,rx-queues-to-use = <1>;
				queue0 {};
			};

			gmac0_mtl_tx_setup: tx-queues-config {
				snps,tx-queues-to-use = <1>;
				queue0 {};
			};
		};

		ufs: ufs@29e00000 {
			compatible = "rockchip,rk3572-ufs", "rockchip,rk3576-ufs";
			reg = <0x0 0x29e00000 0 0x10000>, /* 0: HCI standard */
			      <0x0 0x2c400000 0 0x10000>, /* 1: Mphy */
			      <0x0 0x26027000 0 0x1000>,  /* 2: HCI Vendor specified */
			      <0x0 0x26058000 0 0x2000>,  /* 3: Mphy Vendor specified */
			      <0x0 0x29e10000 0 0x10000>; /* 4: HCI apb */
			reg-names = "hci", "mphy", "hci_grf", "mphy_grf", "hci_apb";
			clocks = <&cru ACLK_UFS_SYS>, <&cru PCLK_PHP0_ROOT>, <&cru PCLK_MPHY>,
				 <&cru CLK_REF_UFS_CLKOUT>;
			clock-names = "core", "pclk", "pclk_mphy",
				      "ref_out";
			assigned-clocks = <&cru CLK_REF_OSC_MPHY>;
			assigned-clock-parents = <&cru CLK_REF_MPHY_26M>;
			interrupts = <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&power RK3572_PD_PHP>;
			pinctrl-0 = <&ufs_refclk_pins &ufs_rstgpio>;
			pinctrl-names = "default";
			resets = <&cru SRST_ARESETN_UFS_BIU>, <&cru SRST_ARESETN_UFS_SYS>,
				 <&cru SRST_ARESETN_UFS>, <&cru SRST_PRESETN_UFS_GRF>;
			reset-names = "biu", "sys", "ufs", "grf";
			status = "disabled";
		};

		dsmc: dsmc@29f00000 {
			compatible = "rockchip,rk3572-dsmc";
			reg = <0x0 0x29f00000 0x0 0x10000>;
			rockchip,grf = <&dsmc_grf>;
			interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dsmc";
			resets = <&cru SRST_ARESETN_DSMC>, <&cru SRST_PRESETN_DSMC>;
			reset-names = "dsmc", "apb";
			clocks = <&cru CLK_DSMC_SYS>, <&cru ACLK_DSMC>, <&cru PCLK_DSMC>,
				 <&cru ACLK_DSMC_ROOT>, <&cru HCLK_DSMC_ROOT>,
				 <&cru PCLK_DSMC_ROOT>, <&cru PCLK_DSMCSUBSYS_ROOT>;
			clock-names = "clk_sys", "aclk_dsmc", "pclk",
				      "aclk_root", "hclk_root",
				      "pclk_root", "pclk_subsys_root";
			clock-frequency = <100000000>;
			dmas = <&dmac0 59>, <&dmac0 60>;
			dma-names = "req0", "req1";
			pinctrl-names = "default";
			pinctrl-0 = <&dsmc_bus16_pins>;
			status = "disabled";
			slave {
				rockchip,dqs-dll = <0x40 0x40
						0x40 0x40
						0x40 0x40
						0x40 0x40>;
				rockchip,ranges = <0x0 0x10000000 0x0 0x2000000>;
				rockchip,slave-dev = <&dsmc_slave>;
			};
		};

		dsmc_slave: dsmc-slave {
			compatible = "rockchip,dsmc-slave";
			rockchip,clk-mode = <0>;
			status = "disabled";
			psram {
				dsmc_psram0: psram0 {
					status = "disabled";
				};
				dsmc_psram1: psram1 {
					status = "disabled";
				};
				dsmc_psram2: psram2 {
					status = "disabled";
				};
				dsmc_psram3: psram3 {
					status = "disabled";
				};
			};

			lb-slave {
				dsmc_lb_slave0: lb-slave0 {
					rockchip,mtr-timing = <1 0 0 0 0 0 2 2>;
					status = "disabled";
					dsmc_p0_region: region {
						dsmc_p0_region0: region0 {
							rockchip,attribute = "Merged FIFO";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p0_region1: region1 {
							rockchip,attribute = "No-Merge FIFO";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p0_region2: region2 {
							rockchip,attribute = "DPRA";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p0_region3: region3 {
							rockchip,attribute = "Register";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
					};
				};
				dsmc_lb_slave1: lb-slave1 {
					rockchip,mtr-timing = <1 0 0 0 0 0 2 2>;
					status = "disabled";
					dsmc_p1_region: region {
						dsmc_p1_region0: region0 {
							rockchip,attribute = "Merged FIFO";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p1_region1: region1 {
							rockchip,attribute = "No-Merge FIFO";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p1_region2: region2 {
							rockchip,attribute = "DPRA";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p1_region3: region3 {
							rockchip,attribute = "Register";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
					};
				};
				dsmc_lb_slave2: lb-slave2 {
					rockchip,mtr-timing = <1 0 0 0 0 0 2 2>;
					status = "disabled";
					dsmc_p2_region: region {
						dsmc_p2_region0: region0 {
							rockchip,attribute = "Merged FIFO";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p2_region1: region1 {
							rockchip,attribute = "No-Merge FIFO";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p2_region2: region2 {
							rockchip,attribute = "DPRA";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p2_region3: region3 {
							rockchip,attribute = "Register";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
					};
				};
				dsmc_lb_slave3: lb-slave3 {
					rockchip,mtr-timing = <1 0 0 0 0 0 2 2>;
					status = "disabled";
					dsmc_p3_region: region {
						dsmc_p3_region0: region0 {
							rockchip,attribute = "Merged FIFO";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p3_region1: region1 {
							rockchip,attribute = "No-Merge FIFO";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p3_region2: region2 {
							rockchip,attribute = "DPRA";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
						dsmc_p3_region3: region3 {
							rockchip,attribute = "Register";
							rockchip,ca-addr-width = <0>;
							rockchip,dummy-clk-num = <1>;
							rockchip,cs0-be-ctrled = <0>;
							rockchip,cs0-ctrl = <0>;
							status = "disabled";
						};
					};
				};
			};
		};

		sdmmc1: mmc@2a000000 {
			compatible = "rockchip,rk3572-dw-mshc", "rockchip,rk3576-dw-mshc";
			reg = <0x0 0x2a000000 0x0 0x4000>;
			interrupts = <GIC_SPI 245 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru HCLK_SDMMC1>, <&cru CCLK_SRC_SDMMC1>;
			clock-names = "biu", "ciu";
			fifo-depth = <0x100>;
			max-frequency = <200000000>;
			pinctrl-names = "default";
			pinctrl-0 = <&sdmmc1_bus4_pins &sdmmc1_clk_pins &sdmmc1_cmd_pins
				     &sdmmc1_pwren_pins &sdmmc1m0_det_pins>;
			power-domains = <&power RK3572_PD_NVM0>;
			resets = <&cru SRST_HRESETN_SDMMC1>;
			reset-names = "reset";
			status = "disabled";
		};

		sdhci: mmc@2a010000 {
			compatible = "rockchip,rk3572-dwcmshc", "rockchip,rk3576-dwcmshc";
			reg = <0x0 0x2a010000 0x0 0x10000>;
			interrupts = <GIC_SPI 243 IRQ_TYPE_LEVEL_HIGH>;
			assigned-clocks = <&cru BCLK_EMMC>, <&cru TCLK_EMMC>, <&cru CCLK_SRC_EMMC>;
			assigned-clock-rates = <200000000>, <24000000>, <200000000>;
			clocks = <&cru CCLK_SRC_EMMC>, <&cru HCLK_EMMC>,
				 <&cru ACLK_EMMC>, <&cru BCLK_EMMC>,
				 <&cru TCLK_EMMC>;
			clock-names = "core", "bus", "axi", "block", "timer";
			max-frequency = <200000000>;
			power-domains = <&power RK3572_PD_NVM0>;
			resets = <&cru SRST_CRESETN_EMMC>, <&cru SRST_HRESETN_EMMC>,
				 <&cru SRST_ARESETN_EMMC>, <&cru SRST_BRESETN_EMMC>,
				 <&cru SRST_TRESETN_EMMC>;
			reset-names = "core", "bus", "axi", "block", "timer";
			supports-cqe;
			status = "disabled";
		};

		fspi0: spi@2a020000 {
			compatible = "rockchip,rk3572-fspi", "rockchip,fspi";
			reg = <0x0 0x2a020000 0x0 0x4000>;
			interrupts = <GIC_SPI 246 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_FSPI0_X2>, <&cru HCLK_FSPI0>;
			clock-names = "clk_sfc", "hclk_sfc";
			power-domains = <&power RK3572_PD_NVM0>;
			rockchip,max-dll = <0xFF>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		gmac1: ethernet@2a040000 {
			compatible = "rockchip,rk3572-gmac", "snps,dwmac-4.20a";
			reg = <0x0 0x2a040000 0x0 0x10000>;
			interrupts = <GIC_SPI 236 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 241 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_wake_irq";
			rockchip,grf = <&nvm0_grf>;
			rockchip,php-grf = <&ioc_grf>;
			clocks = <&cru CLK_GMAC1_125M_SRC>, <&cru CLK_GMAC1_RMII_CRU>,
				 <&cru PCLK_GMAC1>, <&cru ACLK_GMAC1>,
				 <&cru CLK_GMAC1_PTP_REF_SRC>;
			clock-names = "stmmaceth", "clk_mac_ref",
				      "pclk_mac", "aclk_mac",
				      "ptp_ref";
			resets = <&cru SRST_ARESETN_GMAC1>;
			reset-names = "stmmaceth";
			power-domains = <&power RK3572_PD_NVM0>;

			dma-coherent;
			snps,mixed-burst;
			snps,tso;

			snps,axi-config = <&gmac1_stmmac_axi_setup>;
			snps,mtl-rx-config = <&gmac1_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac1_mtl_tx_setup>;
			status = "disabled";

			mdio1: mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <0x1>;
				#size-cells = <0x0>;
			};

			gmac1_stmmac_axi_setup: stmmac-axi-config {
				snps,wr_osr_lmt = <4>;
				snps,rd_osr_lmt = <8>;
				snps,blen = <0 0 0 0 16 8 4>;
			};

			gmac1_mtl_rx_setup: rx-queues-config {
				snps,rx-queues-to-use = <1>;
				queue0 {};
			};

			gmac1_mtl_tx_setup: tx-queues-config {
				snps,tx-queues-to-use = <1>;
				queue0 {};
			};
		};

		fspi1: spi@2a080000 {
			compatible = "rockchip,rk3572-fspi", "rockchip,fspi";
			reg = <0x0 0x2a080000 0x0 0x4000>;
			interrupts = <GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_FSPI1_X2>, <&cru HCLK_FSPI1>;
			clock-names = "clk_sfc", "hclk_sfc";
			power-domains = <&power RK3572_PD_NVM1>;
			rockchip,max-dll = <0xFF>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		sdmmc0: mmc@2a090000 {
			compatible = "rockchip,rk3572-dw-mshc", "rockchip,rk3576-dw-mshc";
			reg = <0x0 0x2a090000 0x0 0x4000>;
			interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru HCLK_SDMMC0>, <&cru CCLK_SRC_SDMMC0>;
			clock-names = "biu", "ciu";
			fifo-depth = <0x100>;
			max-frequency = <200000000>;
			pinctrl-names = "default";
			pinctrl-0 = <&sdmmc0m0_bus4_pins &sdmmc0m0_clk_pins &sdmmc0m0_cmd_pins
				     &sdmmc0m0_det_pins>;
			power-domains = <&power RK3572_PD_NVM1>;
			resets = <&cru SRST_HRESETN_SDMMC0>;
			reset-names = "reset";
			status = "disabled";
		};

		crypto: crypto@2a100000 {
			compatible = "rockchip,crypto-ce";
			reg = <0x0 0x2a100000 0x0 0x2000>;
			interrupts = <GIC_SPI 165 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_CRYPTO_NS>, <&cru HCLK_CRYPTO_NS>, <&cru CLK_PKA_CRYPTO_NS>;
			clock-names = "aclk", "hclk", "pka";
			resets = <&cru SRST_HRESETN_CRYPTO_NS>;
			reset-names = "crypto-rst";
			status = "disabled";
		};

		rng: rng@2a110000 {
			compatible = "rockchip,rkrng";
			reg = <0x0 0x2a110000 0x0 0x200>;
			interrupts = <GIC_SPI 167 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru HCLK_TRNG_NS>;
			clock-names = "hclk_trng_ns";
			resets = <&cru SRST_HRESETN_TRNG_NS>;
			reset-names = "reset";
			status = "disabled";
		};

		otp: otp@2a480000 {
			compatible = "rockchip,rk3572-otp";
			reg = <0x0 0x2a480000 0x0 0x400>;
			#address-cells = <1>;
			#size-cells = <1>;
			clocks = <&cru CLK_OTPC_NS>, <&cru PCLK_OTPC_NS>;
			clock-names = "otpc", "apb";
			resets = <&cru SRST_RESETN_OTPC_NS>, <&cru SRST_PRESETN_OTPC_NS>;
			reset-names = "otpc", "apb";

			/* Data cells */
			cpu_code: cpu-code@2 {
				reg = <0x02 0x2>;
			};
			otp_cpu_version: cpu-version@21 {
				reg = <0x21 0x1>;
				bits = <3 3>;
			};
			otp_id: id@22 {
				reg = <0x22 0x10>;
			};
			cpub_leakage: cpub-leakage@32 {
				reg = <0x32 0x1>;
			};
			cpul_leakage: cpul-leakage@33 {
				reg = <0x33 0x1>;
			};
			gpu_leakage: npu-leakage@34 {
				reg = <0x34 0x1>;
			};
			npu_leakage: npu-leakage@35 {
				reg = <0x35 0x1>;
			};
			logic_leakage: logic-leakage@36 {
				reg = <0x36 0x1>;
			};
		};

		sai0: sai@2a500000 {
			compatible = "rockchip,rk3572-sai", "rockchip,sai-v1";
			reg = <0x0 0x2a500000 0x0 0x1000>;
			interrupts = <GIC_SPI 175 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru MCLK_SAI0>, <&cru HCLK_SAI0>;
			clock-names = "mclk", "hclk";
			dmas = <&dmac0 0>, <&dmac0 1>;
			dma-names = "tx", "rx";
			power-domains = <&power RK3572_PD_AUDIO>;
			resets = <&cru SRST_MRESETN_SAI0>, <&cru SRST_HRESETN_SAI0>;
			reset-names = "m", "h";
			pinctrl-names = "default";
			pinctrl-0 = <&sai0m0_lrck_pins
				     &sai0m0_sclk_pins
				     &sai0m0_sdi0_pins
				     &sai0m0_sdi1_pins
