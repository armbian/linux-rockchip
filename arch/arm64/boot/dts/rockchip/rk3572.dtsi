			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart8: serial@2c1a0000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c1a0000 0x0 0x100>;
			interrupts = <GIC_SPI 132 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART8>, <&cru PCLK_UART8>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 37>, <&dmac0 38>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart8m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart9: serial@2c1b0000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c1b0000 0x0 0x100>;
			interrupts = <GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART9>, <&cru PCLK_UART9>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 39>, <&dmac0 40>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart9m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart10: serial@2c1c0000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c1c0000 0x0 0x100>;
			interrupts = <GIC_SPI 134 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART10>, <&cru PCLK_UART10>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 41>, <&dmac0 42>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart10m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart11: serial@2c1d0000 {
			compatible = "rockchip,rk3572-uart", "snps,dw-apb-uart";
			reg = <0x0 0x2c1d0000 0x0 0x100>;
			interrupts = <GIC_SPI 135 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru SCLK_UART11>, <&cru PCLK_UART11>;
			clock-names = "baudclk", "apb_pclk";
			dmas = <&dmac0 43>, <&dmac0 44>;
			pinctrl-names = "default";
			pinctrl-0 = <&uart11m0_xfer_pins>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		saradc: adc@2c1e0000 {
			compatible = "rockchip,rk3572-saradc", "rockchip,rk3588-saradc";
			reg = <0x0 0x2c1e0000 0x0 0x1000>;
			interrupts = <GIC_SPI 157 IRQ_TYPE_LEVEL_HIGH>;
			#io-channel-cells = <1>;
			clocks = <&cru CLK_SARADC>, <&cru PCLK_SARADC>;
			clock-names = "saradc", "apb_pclk";
			resets = <&cru SRST_PRESETN_SARADC>, <&cru SRST_RESETN_SARADC>;
			reset-names = "saradc-apb", "saradc";
			status = "disabled";
		};

		tsadc: tsadc@2c1f0000 {
			compatible = "rockchip,rk3572-tsadc";
			reg = <0x0 0x2c1f0000 0x0 0x1000>;
			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru CLK_TSADC>, <&cru PCLK_TSADC>;
			clock-names = "tsadc", "apb_pclk";
			assigned-clocks = <&cru CLK_TSADC>;
			assigned-clock-rates = <2000000>;
			resets = <&cru SRST_RESETN_TSADC>, <&cru SRST_PRESETN_TSADC>;
			reset-names = "tsadc", "tsadc-apb";
			#thermal-sensor-cells = <1>;
			rockchip,hw-tshut-temp = <120000>;
			rockchip,hw-tshut-mode = <0>; /* tshut mode 0:CRU 1:GPIO */
			rockchip,hw-tshut-polarity = <0>; /* tshut polarity 0:LOW 1:HIGH */
			status = "disabled";
		};

		mipitx_dphy: phy@2c300000 {
			compatible = "rockchip,rk3572-dsi-dphy", "rockchip,rk3572-video-phy";
			reg = <0x0 0x2c300000 0x0 0x10000>,
			      <0x0 0x276d0000 0x0 0x10000>;
			reg-names = "phy", "host";
			clocks = <&xin24m>, <&cru PCLK_MIPI_DPHY0>, <&cru PCLK_DSIHOST0>;
			clock-names = "ref", "pclk", "pclk_host";
			#clock-cells = <0>;
			resets = <&cru SRST_PRESETN_MIPI_DPHY0>;
			reset-names = "apb";
			#phy-cells = <0>;
			status = "disabled";
		};

		hdptxphy: phy@2c310000 {
			compatible = "rockchip,rk3572-hdptx-phy", "rockchip,rk3588-hdptx-phy";
			reg = <0x0 0x2c310000 0x0 0x10000>;
			clocks = <&xin24m>, <&cru PCLK_HDPTXPHY>;
			clock-names = "ref", "apb";
			resets = <&cru SRST_PRESETN_HDPTXPHY>, <&cru SRST_RESETN_HDPTX_INIT>,
				 <&cru SRST_RESETN_HDPTX_CMN>, <&cru SRST_RESETN_HDPTX_LANE>;
			reset-names = "apb", "init", "cmn", "lane";
			rockchip,grf = <&hdptxphy_grf>;
			#phy-cells = <0>;
			status = "disabled";
		};

		hdptxphy_hdmi: hdmiphy@2c310000 {
			compatible = "rockchip,rk3572-hdptx-phy-hdmi",
				     "rockchip,rk3588-hdptx-phy-hdmi";
			reg = <0x0 0x2c310000 0x0 0x2000>;
			clocks = <&xin24m>, <&cru PCLK_HDPTXPHY>;
			clock-names = "ref", "apb";
			clock-output-names = "clk_hdmiphy_pixel0";
			#clock-cells = <0>;
			resets = <&cru SRST_PRESETN_HDPTXPHY>, <&cru SRST_RESETN_HDPTX_INIT>,
				 <&cru SRST_RESETN_HDPTX_CMN>, <&cru SRST_RESETN_HDPTX_LANE>;
			reset-names = "apb", "init", "cmn", "lane";
			rockchip,grf = <&hdptxphy_grf>;
			#phy-cells = <0>;
			status = "disabled";
		};

		csi2_dphy0_hw: csi2-dphy0-hw@2c330000 {
			compatible = "rockchip,rk3572-csi2-dphy-hw";
			reg = <0x0 0x2c330000 0x0 0x10000>;
			clocks = <&cru PCLK_CSIPHY0>;
			clock-names = "pclk";
			resets = <&cru SRST_PRESETN_CSIPHY0>;
			reset-names = "srst_p_csiphy0";
			rockchip,grf = <&mipidphyrx0_grf>;
			rockchip,sys_grf = <&vi_grf>;
			status = "okay";
		};

		csi2_dphy1_hw: csi2-dphy1-hw@2c340000 {
			compatible = "rockchip,rk3572-csi2-dphy-hw";
			reg = <0x0 0x2c340000 0x0 0x10000>;
			clocks = <&cru PCLK_CSIPHY1>;
			clock-names = "pclk";
			resets = <&cru SRST_PRESETN_CSIPHY1>;
			reset-names = "srst_p_csiphy1";
			rockchip,grf = <&mipidphyrx1_grf>;
			rockchip,sys_grf = <&vi_grf>;
			status = "okay";
		};

		combphy0_psu: phy@2c410000 {
			compatible = "rockchip,rk3572-pipe-combphy";
			reg = <0x0 0x2c410000 0x0 0x100>;
			#phy-cells = <1>;
			clocks = <&cru CLK_REF_PCIE0_INNER_PHY>, <&cru PCLK_PCIE2_COMBOPHY0>;
			clock-names = "refclk", "apbclk";
			assigned-clocks = <&cru CLK_REF_PCIE0_INNER_PHY>;
			assigned-clock-rates = <100000000>;
			resets = <&cru SRST_PRESETN_PCIE2_COMBOPHY0>, <&cru SRST_RESETN_PCIE0_PIPE_PHY>;
			reset-names = "combphy-apb", "combphy";
			rockchip,pipe-grf = <&php_grf>;
			rockchip,pipe-phy-grf = <&pipe_phy0_grf>;
			status = "disabled";
		};

		combphy1_psu: phy@2c420000 {
			compatible = "rockchip,rk3572-pipe-combphy";
			reg = <0x0 0x2c420000 0x0 0x100>;
			#phy-cells = <1>;
			clocks = <&cru CLK_REF_PCIE1_INNER_PHY>, <&cru PCLK_PCIE2_COMBOPHY1>;
			clock-names = "refclk", "apbclk";
			assigned-clocks = <&cru CLK_REF_PCIE1_INNER_PHY>;
			assigned-clock-rates = <100000000>;
			resets = <&cru SRST_PRESETN_PCIE2_COMBOPHY1>, <&cru SRST_RESETN_PCIE1_PIPE_PHY>;
			reset-names = "combphy-apb", "combphy";
			rockchip,pipe-grf = <&php_grf>;
			rockchip,pipe-phy-grf = <&pipe_phy1_grf>;
			status = "disabled";
		};

		combphy2_ps: phy@2c430000 {
			compatible = "rockchip,rk3572-pipe-combphy";
			reg = <0x0 0x2c430000 0x0 0x100>;
			#phy-cells = <1>;
			clocks = <&cru CLK_REF_PCIEPHY2>, <&cru PCLK_PCIEPHY2>;
			clock-names ="refclk", "apbclk";
			assigned-clocks = <&cru CLK_REF_PCIEPHY2>;
			assigned-clock-rates = <100000000>;
			resets = <&cru SRST_PRESETN_PCIEPHY2>, <&cru SRST_RESETN_PCIEPHY2>;
			reset-names = "combphy-apb", "combphy";
			rockchip,pipe-grf = <&php_grf>;
			rockchip,pipe-phy-grf = <&pipe_phy2_grf>;
			status = "disabled";
		};

		gpu: gpu@2d000000 {
			compatible = "arm,mali-valhall";
			reg = <0x0 0x2d000000 0x0 0x200000>;
			interrupts = <GIC_SPI 334 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 332 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 333 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "GPU", "MMU", "JOB";

			clocks = <&cru CLK_GPU_COREGROUP>, <&cru CLK_GPU_STACKS>,
				 <&cru CLK_GPU>;
			clock-names = "clk_gpu_coregroup", "clk_gpu_stacks",
				      "clk_gpu";
			power-domains = <&power RK3572_PD_GPU>;

			upthreshold = <30>;
			downdifferential = <10>;

			status = "disabled";
		};

		sram: sram@3ff88000 {
			compatible = "mmio-sram";
			reg = <0x0 0x3ff88000 0x0 0x78000>;

			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0x3ff88000 0x78000>;

			/* start address and size should be 4k align */
			rkvdec_sram: rkvdec-sram@0 {
				reg = <0x0 0x78000>;
			};
		};

		scmi_shmem: scmi-shmem@4010f000 {
			compatible = "arm,scmi-shmem";
			reg = <0x0 0x4010f000 0x0 0x100>;
		};
	};
};

#include "rk3572-pinctrl.dtsi"
